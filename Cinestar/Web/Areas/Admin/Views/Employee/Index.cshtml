@model IEnumerable<Web.Models.Employee>

@{
    ViewData["Title"] = "Quản lý Nhân viên";
}

@section Styles {
    <link href="~/css/Admin/Employee.css" rel="stylesheet" />
}

<div class="row mb-3">
    <div class="col-md-12">
        <h2><i class="fas fa-users"></i> Quản lý Nhân viên</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Dashboard</a></li>
                <li class="breadcrumb-item active">Quản lý Nhân viên</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Filter Section -->
<div class="filter-section">
    <form method="get" asp-action="Index">
        <div class="row g-3">
            <div class="col-md-3">
                <select name="branchId" class="form-select">
                    <option value="">-- Chi nhánh --</option>
                    @if (ViewBag.Branches != null)
                    {
                        foreach (CinemaBranch branch in ViewBag.Branches)
                        {
                            <option value="@branch.BranchID" selected="@(branch.BranchID == ViewBag.CurrentBranch)">@branch.BranchName</option>
                        }
                    }
                </select>
            </div>
            
            <div class="col-md-2">
                <select name="role" class="form-select">
                    <option value="">-- Tất cả chức vụ --</option>
                    @if (ViewBag.Roles != null)
                    {
                        foreach (var role in ViewBag.Roles)
                        {
                            <option value="@role" selected="@(role == ViewBag.CurrentRole)">@role</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="sortBy" class="form-select">
                    <option value="">-- Sắp xếp --</option>
                    <option value="name_asc" selected="@(ViewBag.CurrentSort == "name_asc")">Tên A-Z</option>
                    <option value="name_desc" selected="@(ViewBag.CurrentSort == "name_desc")">Tên Z-A</option>
                    <option value="date_asc" selected="@(ViewBag.CurrentSort == "date_asc")">Cũ nhất</option>
                    <option value="date_desc" selected="@(ViewBag.CurrentSort == "date_desc")">Mới nhất</option>
                </select>
            </div>
            <div class="col-md-3">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text"
                           name="searchTerm"
                           class="form-control"
                           placeholder="Tìm kiếm theo tên, email, SĐT..."
                           value="@ViewBag.CurrentSearch">
                </div>
            </div>
            <div class="col-md-2">
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-fill">
                        <i class="fas fa-filter"></i>
                    </button>
                    <a asp-action="Create" class="btn btn-success flex-fill">
                        <i class="fas fa-plus"></i> 
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>

@if (ViewBag.CurrentBranch == null)
{
    <div class="no-employees">
        <i class="fas fa-building"></i>
        <h4>Vui lòng chọn chi nhánh</h4>
        <p>Chọn chi nhánh từ bộ lọc phía trên để xem danh sách nhân viên</p>
    </div>
}
else if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var employee in Model)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="employee-card">
                    <div class="employee-image-container">
                        @if (!string.IsNullOrEmpty(employee.ImageUrl))
                        {
                            <img src="@employee.ImageUrl" alt="@employee.FullName" class="employee-image">
                        }
                        else
                        {
                            <img src="~/image/employee/default-avatar.png" alt="Default Avatar" class="employee-image">
                        }

                        <!-- Overlay with detailed info -->
                        <div class="employee-overlay">
                            <h5>@employee.FullName</h5>
                            <div class="info-item">
                                <i class="fas fa-briefcase"></i> @employee.Role
                            </div>
                            @if (!string.IsNullOrEmpty(employee.Phone))
                            {
                                <div class="info-item">
                                    <i class="fas fa-phone"></i> @employee.Phone
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(employee.Email))
                            {
                                <div class="info-item">
                                    <i class="fas fa-envelope"></i> @employee.Email
                                </div>
                            }
                            @if (employee.BirthDate.HasValue)
                            {
                                <div class="info-item">
                                    <i class="fas fa-birthday-cake"></i> @employee.BirthDate.Value.ToString("dd/MM/yyyy")
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(employee.Gender))
                            {
                                <div class="info-item">
                                    <i class="fas fa-venus-mars"></i> @employee.Gender
                                </div>
                            }
                            @if (employee.HourWage.HasValue)
                            {
                                <div class="info-item">
                                    <i class="fas fa-money-bill-wave"></i> @employee.HourWage.Value.ToString("N0") đ/giờ
                                </div>
                            }
                            <div class="info-item">
                                <i class="fas fa-calendar"></i> @(employee.RegisterDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")
                            </div>
                        </div>
                    </div>

                    <!-- Basic Info -->
                    <div class="employee-basic-info">
                        <div class="employee-name">@employee.FullName</div>
                        <div class="employee-role">@employee.Role</div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="employee-actions">
                        <a asp-action="Edit" asp-route-id="@employee.EmployeeID" class="btn btn-sm btn-primary">
                            <i class="fas fa-edit"></i> Sửa
                        </a>
                        <form asp-action="Delete" asp-route-id="@employee.EmployeeID" method="post" style="margin: 0;">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc muốn thôi việc nhân viên này?')">
                                <i class="fas fa-trash"></i> Thôi việc
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="no-employees">
        <i class="fas fa-user-slash"></i>
        <h4>Không tìm thấy nhân viên nào</h4>
        <p>Hãy thêm nhân viên mới hoặc thay đổi bộ lọc tìm kiếm</p>
        <a asp-action="Create" class="btn btn-primary mt-3">
            <i class="fas fa-plus"></i> Thêm nhân viên mới
        </a>
    </div>
}