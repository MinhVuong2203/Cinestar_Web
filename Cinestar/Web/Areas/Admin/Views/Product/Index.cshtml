@model IEnumerable<Web.Models.Product>

@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    var productTypes = ViewBag.ProductTypes as List<string> ?? new List<string>();
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <h2 class="mb-4">
                <i class="fas fa-box"></i> Quản lý Sản phẩm
            </h2>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Bộ lọc và tìm kiếm -->
    <div class="card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Tìm kiếm</label>
                        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]"
                               class="form-control" placeholder="Tên sản phẩm hoặc mã...">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Loại sản phẩm</label>
                        <select name="productType" class="form-select">
                            <option value="">-- Tất cả --</option>
                            @foreach (var type in productTypes)
                            {
                                <option value="@type" selected="@(type == ViewData["ProductType"]?.ToString())">@type</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Trạng thái</label>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="showDeleted"
                                   value="true" id="showDeleted" @(ViewData["ShowDeleted"]?.ToString() == "True" ? "checked" : "")>
                            <label class="form-check-label" for="showDeleted">
                                Hiện đã xóa
                            </label>
                        </div>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary me-2">
                            <i class="fas fa-search"></i> Tìm kiếm
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-redo"></i> Làm mới
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Nút thêm mới -->
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-success">
            <i class="fas fa-plus"></i> Thêm sản phẩm mới
        </a>
    </div>

    <!-- Bảng danh sách sản phẩm -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Hình ảnh</th>
                            <th>Mã SP</th>
                            <th>Tên sản phẩm</th>
                            <th>Loại</th>
                            <th class="text-end">Giá</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.IsDeleted ? "table-secondary" : "")">
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.ProductName"
                                                 class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-secondary text-white d-flex align-items-center justify-content-center"
                                                 style="width: 60px; height: 60px;">
                                                <i class="fas fa-image"></i>
                                            </div>
                                        }
                                    </td>
                                    <td>@item.ProductID</td>
                                    <td>
                                        <strong>@item.ProductName</strong>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.ProductType))
                                        {
                                            <span class="badge bg-info">@item.ProductType</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <strong class="text-danger">@(item.Price?.ToString("N0") ?? "0") ₫</strong>
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsDeleted)
                                        {
                                            <span class="badge bg-danger">Ngừng bán</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Đang bán</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                        

                                            @if (!item.IsDeleted)
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.ProductID"
                                                   class="btn btn-sm btn-warning" title="Chỉnh sửa">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-danger"
                                                        data-bs-toggle="modal" data-bs-target="#deleteModal-@item.ProductID"
                                                        title="Ngừng bán">
                                                    <i class="fas fa-ban"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="btn btn-sm btn-success"
                                                        data-bs-toggle="modal" data-bs-target="#restoreModal-@item.ProductID"
                                                        title="Khôi phục">
                                                    <i class="fas fa-undo"></i>
                                                </button>
                                            }
                                        </div>

                                        <!-- Modal Xác nhận ngừng bán -->
                                        <div class="modal fade" id="deleteModal-@item.ProductID" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-danger text-white">
                                                        <h5 class="modal-title">Xác nhận ngừng bán</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p>Bạn có chắc chắn muốn ngừng bán sản phẩm <strong>@item.ProductName</strong>?</p>
                                                        <p class="text-muted small">Sản phẩm sẽ không hiển thị cho khách hàng nhưng vẫn giữ lại dữ liệu.</p>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                        <form asp-action="Delete" method="post" class="d-inline">
                                                            <input type="hidden" name="id" value="@item.ProductID" />
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-danger">Ngừng bán</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Modal Xác nhận khôi phục -->
                                        <div class="modal fade" id="restoreModal-@item.ProductID" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-success text-white">
                                                        <h5 class="modal-title">Xác nhận khôi phục</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <p>Bạn có chắc chắn muốn khôi phục sản phẩm <strong>@item.ProductName</strong>?</p>
                                                        <p class="text-muted small">Sản phẩm sẽ được bán trở lại.</p>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                        <form asp-action="Restore" method="post" class="d-inline">
                                                            <input type="hidden" name="id" value="@item.ProductID" />
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit" class="btn btn-success">Khôi phục</button>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                                    <p class="text-muted">Không tìm thấy sản phẩm nào</p>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Tự động ẩn thông báo sau 5 giây
        setTimeout(function() {
            $('.alert').fadeOut('slow');
        }, 5000);
    </script>
}