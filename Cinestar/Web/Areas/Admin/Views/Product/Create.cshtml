@model Web.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm mới";
}

@section Styles{
    <link href="/css/Admin/Product.css" rel="stylesheet" />
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0">
                        <i class="fas fa-plus-circle"></i> Thêm sản phẩm mới
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data" id="productForm">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <!-- Cột trái - Thông tin sản phẩm -->
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="ProductName" class="form-label">
                                        Tên sản phẩm <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="ProductName" class="form-control" placeholder="VD: Bắp rang bơ lớn" />
                                    <span asp-validation-for="ProductName" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="ProductType" class="form-label">
                                        Loại sản phẩm
                                    </label>
                                    <input asp-for="ProductType" class="form-control" 
                                           list="productTypeList" placeholder="VD: Đồ ăn, Nước uống, Combo..." />
                                    <datalist id="productTypeList">                                      
                                        <option value="NƯỚC NGỌT">NƯỚC NGỌT</option>
                                        <option value="COMBO 2 NGĂN">COMBO 2 NGĂN</option>
                                        <option value="NƯỚC ĐÓNG CHAI">NƯỚC ĐÓNG CHAI</option>
                                        <option value="POCA">POCA</option>
                                        <option value="SNACKS - KẸO">SNACKS - KẸO</option>
                                    </datalist>
                                    <span asp-validation-for="ProductType" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Price" class="form-label">
                                        Giá (VNĐ)
                                    </label>
                                    <input asp-for="Price" type="number" class="form-control" 
                                           placeholder="0" min="0" step="1000" />
                                    <span asp-validation-for="Price" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Cột phải - Hình ảnh -->
                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">Hình ảnh sản phẩm</label>
                                    <div class="text-center mb-3">
                                        <img id="imagePreview" src="/images/placeholder-product.png" 
                                             class="img-thumbnail" style="width: 100%; max-width: 250px; height: 250px; object-fit: cover;" 
                                             alt="Preview">
                                    </div>
                                    <input type="file" name="imageFile" class="form-control" 
                                           accept="image/*" id="imageInput" onchange="previewImage(this)">
                                    <small class="form-text text-muted">
                                        Định dạng: JPG, PNG, GIF. Tối đa 5MB
                                    </small>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> Quay lại
                            </a>
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Lưu sản phẩm
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function previewImage(input) {
            if (input.files && input.files[0]) {
                // Kiểm tra kích thước file (5MB)
                if (input.files[0].size > 5242880) {
                    alert('Kích thước file không được vượt quá 5MB!');
                    input.value = '';
                    return;
                }

                // Kiểm tra định dạng file
                const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/jpg'];
                if (!allowedTypes.includes(input.files[0].type)) {
                    alert('Chỉ chấp nhận file ảnh định dạng JPG, PNG, GIF!');
                    input.value = '';
                    return;
                }

                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('imagePreview').src = e.target.result;
                }
                reader.readAsDataURL(input.files[0]);
            }
        }

        // Validate form trước khi submit
        document.getElementById('productForm').addEventListener('submit', function(e) {
            const productName = document.querySelector('[name="ProductName"]').value.trim();
            
            if (!productName) {
                e.preventDefault();
                alert('Vui lòng nhập tên sản phẩm!');
                return false;
            }
        });
    </script>
}
