@model IEnumerable<Web.Models.Room>

@{
    ViewData["Title"] = "Quản lý Ghế ngồi";
}

@section Styles {
    <style>
        .stats-card {
            background: linear-gradient(135deg, #17a2b8, #138496);
            color: white;
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }

            .stats-card h3 {
                font-size: 2rem;
                margin: 0;
            }

            .stats-card p {
                margin: 5px 0 0 0;
                opacity: 0.9;
            }

        .table thead th {
            background-color: #f8f9fa;
            font-weight: 600;
            border-bottom: 2px solid #dee2e6;
        }

        .table tbody tr:hover {
            background-color: #f8f9fa;
        }

        .filter-section {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
        }
    </style>
}

<div class="row mb-3">
    <div class="col-md-12">
        <h2> Quản lý Ghế ngồi</h2>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-6">
        <div class="stats-card">
            <h3 id="totalRooms">@ViewBag.TotalRooms</h3>
            <p>Tổng số phòng chiếu</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stats-card">
            <h3 id="totalSeats">@ViewBag.TotalSeats</h3>
            <p>Tổng số ghế</p>
        </div>
    </div>
</div>

<!-- Filter Section -->
<div class="filter-section">
    <div class="row align-items-end">
        <div class="col-md-4">
            <label for="branchFilter" class="form-label">
                <i class="fas fa-filter me-2"></i>Lọc theo Chi nhánh
            </label>
            <select id="branchFilter" class="form-select">
                <option value="">-- Tất cả chi nhánh --</option>
                @if (ViewBag.AllBranches != null)
                {
                    foreach (var branch in ViewBag.AllBranches)
                    {
                        <option value="@branch.BranchID">@branch.BranchName</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button id="resetFilter" class="btn btn-secondary">
                <i class="fas fa-redo me-2"></i>Đặt lại
            </button>
        </div>
    </div>
</div>

<!-- Room Table -->
<div class="card">
    <div class="card-header">
        <span>
            <i class="fas fa-list me-2"></i>Danh sách Phòng chiếu
            <span id="roomCount" class="badge bg-secondary">@Model.Count()</span>
        </span>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Tên phòng</th>
                        <th>Số ghế</th>
                        <th>Loại phòng</th>
                        <th>Chi nhánh</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody id="roomTableBody">
                    @{
                        int index = 1;
                    }
                    @foreach (var room in Model)
                    {
                        var seatCount = room.Seats?.Count ?? 0;

                        <tr data-branch-id="@room.BranchID">
                            <td class="row-number">@index</td>
                            <td>@room.RoomName</td>
                            <td>
                                @if (seatCount > 0)
                                {
                                    <span class="badge bg-success">@seatCount ghế</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Chưa có ghế</span>
                                }
                            </td>
                            <td>@(room.RoomType ?? "Chưa xác định")</td>
                            <td>@(room.Branch?.BranchName ?? "Chưa có chi nhánh")</td>
                            <td>
                                @if (seatCount > 0)
                                {
                                    <a asp-action="Edit" asp-route-id="@room.RoomID"
                                       class="btn btn-sm btn-primary" title="Quản lý ghế">
                                       Quản lý ghế
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa có ghế</span>
                                }
                            </td>
                        </tr>
                        index++;
                    }
                </tbody>
            </table>

            <div id="noResults" style="display: none;" class="text-center py-4">
                <i class="fas fa-inbox fa-3x text-muted mb-3"></i>
                <p class="text-muted">Không tìm thấy phòng chiếu nào</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#branchFilter').change(function() {
                filterRooms();
            });

            $('#resetFilter').click(function() {
                $('#branchFilter').val('');
                filterRooms();
            });

            function filterRooms() {
                var selectedBranch = $('#branchFilter').val();
                var visibleCount = 0;
                var visibleIndex = 1;
                var totalSeats = 0;

                $('#roomTableBody tr').each(function() {
                    var $row = $(this);
                    var branchId = $row.data('branch-id');
                    var shouldShow = true;

                    if (selectedBranch && branchId != selectedBranch) {
                        shouldShow = false;
                    }

                    if (shouldShow) {
                        $row.show();
                        $row.find('.row-number').text(visibleIndex);

                        // Lấy số ghế từ badge
                        var seatText = $row.find('td:eq(2) .badge').text();
                        var seatCount = parseInt(seatText) || 0;
                        totalSeats += seatCount;

                        visibleIndex++;
                        visibleCount++;
                    } else {
                        $row.hide();
                    }
                });

                $('#roomCount').text(visibleCount);
                $('#totalRooms').text(visibleCount);
                $('#totalSeats').text(totalSeats);

                if (visibleCount === 0) {
                    $('#noResults').show();
                } else {
                    $('#noResults').hide();
                }
            }

            filterRooms();
        });
    </script>
}
