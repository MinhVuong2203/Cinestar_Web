@model Web.Areas.Admin.Service.MoviePagedResult

@{
    ViewData["Title"] = "Quản Lý Phim";
}

<link rel="stylesheet" href="~/css/Admin/Movie.css" />

<div class="movie-container">
    <div class="movie-header">
        <h1>
            <i class="fas fa-film"></i> Quản Lý Phim
        </h1>
        <a asp-action="Create" class="btn btn-create">
            <i class="fas fa-plus"></i> Thêm Phim Mới
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-error">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    <div class="movie-filters">
        <form method="get" asp-action="Index" id="filterForm">
            <div class="filter-group">
                <div class="search-box">
                    <input type="text"
                           name="search"
                           id="searchInput"
                           value="@Model.SearchKeyword"
                           placeholder="Tìm kiếm phim theo tên..." />
                    <i class="fas fa-search"></i>
                </div>

                <div class="filter-select">
                    <select name="filter" id="filterSelect" onchange="this.form.submit()">
                        <option value="all" selected="@(Model.FilterStatus == "all" || string.IsNullOrEmpty(Model.FilterStatus))">Tất cả phim</option>
                        <option value="showing" selected="@(Model.FilterStatus == "showing")">Phim đang chiếu</option>
                        <option value="upcoming" selected="@(Model.FilterStatus == "upcoming")">Phim sắp chiếu</option>
                        <option value="ended" selected="@(Model.FilterStatus == "ended")">Phim đã chiếu</option>
                    </select>
                    <i class="fas fa-filter"></i>
                </div>

                <button type="submit" class="btn btn-search">
                    <i class="fas fa-search"></i> Tìm kiếm
                </button>
            </div>
        </form>

        <div class="result-info">
            <span>Tìm thấy <strong>@Model.TotalRecords</strong> phim</span>
            <span>Trang <strong>@Model.CurrentPage</strong> / <strong>@Model.TotalPages</strong></span>
        </div>
    </div>

    <div class="movie-grid">
        @foreach (var movie in Model.Movies)
        {
            <div class="movie-card @(movie.IsDeleted ? "deleted" : "")">
                <div class="movie-image">
                    @if (!string.IsNullOrEmpty(movie.ImageUrl))
                    {
                        <img src="@movie.ImageUrl" alt="@movie.Title" />
                    }
                    else
                    {
                        <div class="no-image">
                            <i class="fas fa-film"></i>
                        </div>
                    }
                    @if (movie.IsDeleted)
                    {
                        <div class="deleted-badge">
                            <i class="fas fa-trash"></i> Đã xóa
                        </div>
                    }

                    @{
                        var now = DateTime.Now;
                        var status = "";
                        var statusClass = "";

                        if (movie.StartTime > now)
                        {
                            status = "Sắp chiếu";
                            statusClass = "status-upcoming";
                        }
                        else if (movie.EndTime.HasValue && movie.EndTime < now)
                        {
                            status = "Đã chiếu";
                            statusClass = "status-ended";
                        }
                        else if (movie.StartTime <= now && (!movie.EndTime.HasValue || movie.EndTime >= now))
                        {
                            status = "Đang chiếu";
                            statusClass = "status-showing";
                        }
                    }

                    @if (!string.IsNullOrEmpty(status))
                    {
                        <div class="status-badge @statusClass">
                            @status
                        </div>
                    }
                </div>

                <div class="movie-content">
                    <h3 class="movie-title">@movie.Title</h3>

                    <div class="movie-info">
                        <span class="info-item">
                            <i class="fas fa-clock"></i> @movie.DurationMinutes phút
                        </span>
                        @if (!string.IsNullOrEmpty(movie.Genre))
                        {
                            <span class="info-item">
                                <i class="fas fa-masks-theater"></i> @movie.Genre
                            </span>
                        }
                    </div>

                    <div class="movie-meta">
                        @if (!string.IsNullOrEmpty(movie.Language))
                        {
                            <span class="meta-badge">
                                <i class="fas fa-language"></i> @movie.Language
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(movie.AgeLimit))
                        {
                            <span class="meta-badge age-limit">@movie.AgeLimit</span>
                        }
                    </div>

                    <div class="movie-dates">
                        @if (movie.StartTime.HasValue)
                        {
                            <div class="date-item">
                                <span class="date-label">Khởi chiếu:</span>
                                <span class="date-value">@movie.StartTime.Value.ToString("dd/MM/yyyy")</span>
                            </div>
                        }
                        @if (movie.EndTime.HasValue)
                        {
                            <div class="date-item">
                                <span class="date-label">Kết thúc:</span>
                                <span class="date-value">@movie.EndTime.Value.ToString("dd/MM/yyyy")</span>
                            </div>
                        }
                    </div>

                    <div class="movie-actions">
                        <a asp-action="Details" asp-route-id="@movie.MovieID" class="btn btn-details" title="Chi tiết">
                            <i class="fas fa-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@movie.MovieID" class="btn btn-edit" title="Sửa">
                            <i class="fas fa-edit"></i>
                        </a>
                        @if (!movie.IsDeleted)
                        {
                            <a asp-action="Delete" asp-route-id="@movie.MovieID" class="btn btn-delete" title="Xóa">
                                <i class="fas fa-trash"></i>
                            </a>
                        }
                        else
                        {
                            <form asp-action="Restore" asp-route-id="@movie.MovieID" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-restore" title="Khôi phục">
                                    <i class="fas fa-undo"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Movies.Any())
    {
        <div class="empty-state">
            <i class="fas fa-film"></i>
            <h3>Không tìm thấy phim nào</h3>
            <p>Thử thay đổi bộ lọc hoặc từ khóa tìm kiếm</p>
            <a asp-action="Index" class="btn btn-create">
                <i class="fas fa-undo"></i> Xem tất cả
            </a>
        </div>
    }
    else
    {
        <!-- Pagination -->
        <div class="pagination-container">
            <div class="pagination">
                @if (Model.HasPreviousPage)
                {
                    <a asp-action="Index"
                       asp-route-page="1"
                       asp-route-search="@Model.SearchKeyword"
                       asp-route-filter="@Model.FilterStatus"
                       class="page-link">
                        <i class="fas fa-angle-double-left"></i>
                    </a>
                    <a asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-search="@Model.SearchKeyword"
                       asp-route-filter="@Model.FilterStatus"
                       class="page-link">
                        <i class="fas fa-angle-left"></i>
                    </a>
                }

                @{
                    var startPage = Math.Max(1, Model.CurrentPage - 2);
                    var endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
                }

                @if (startPage > 1)
                {
                    <a asp-action="Index"
                       asp-route-page="1"
                       asp-route-search="@Model.SearchKeyword"
                       asp-route-filter="@Model.FilterStatus"
                       class="page-link">1</a>
                    @if (startPage > 2)
                    {
                        <span class="page-dots">...</span>
                    }
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <a asp-action="Index"
                       asp-route-page="@i"
                       asp-route-search="@Model.SearchKeyword"
                       asp-route-filter="@Model.FilterStatus"
                       class="page-link @(i == Model.CurrentPage ? "active" : "")">
                        @i
                    </a>
                }

                @if (endPage < Model.TotalPages)
                {
                    @if (endPage < Model.TotalPages - 1)
                    {
                        <span class="page-dots">...</span>
                    }
                    <a asp-action="Index"
                       asp-route-page="@Model.TotalPages"
                       asp-route-search="@Model.SearchKeyword"
                       asp-route-filter="@Model.FilterStatus"
                       class="page-link">@Model.TotalPages</a>
                }

                @if (Model.HasNextPage)
                {
                    <a asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-search="@Model.SearchKeyword"
                       asp-route-filter="@Model.FilterStatus"
                       class="page-link">
                        <i class="fas fa-angle-right"></i>
                    </a>
                    <a asp-action="Index"
                       asp-route-page="@Model.TotalPages"
                       asp-route-search="@Model.SearchKeyword"
                       asp-route-filter="@Model.FilterStatus"
                       class="page-link">
                        <i class="fas fa-angle-double-right"></i>
                    </a>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Auto submit form khi nhấn Enter trong search box
        document.getElementById('searchInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                document.getElementById('filterForm').submit();
            }
        });

        // Clear search
        const searchInput = document.getElementById('searchInput');
        if (searchInput.value) {
            const clearBtn = document.createElement('button');
            clearBtn.innerHTML = '<i class="fas fa-times"></i>';
            clearBtn.className = 'clear-search';
            clearBtn.type = 'button';
            clearBtn.onclick = function() {
                searchInput.value = '';
                document.getElementById('filterForm').submit();
            };
            searchInput.parentElement.appendChild(clearBtn);
        }
    </script>
}