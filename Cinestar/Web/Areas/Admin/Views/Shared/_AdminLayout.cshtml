@{
    var role = User?.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var employeeName = User?.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "";
    var employeeId = User?.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";

    // Xác định prefix URL theo role
    string urlPrefix = role switch
    {
        "Admin" => "admin",
        "EmployeeSales" => "employee-sales",
        "EmployeeTechnician" => "employee-technician",
        "EmployeeMovies" => "employee-movies",
        _ => "admin"
    };
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cinestar Admin</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/lib/fontawesome-free-7.1.0-web/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/Admin/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar">
            <div class="sidebar-header">
                <img src="~/image/header-logo.webp" alt="Alternate Text" class="sidebar_img" />
            </div>

            @if (role.Equals("Admin"))
            {
                <ul class="list-unstyled components">
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <a href="/@urlPrefix">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Branch" ? "active" : "")">
                        <a href="/@urlPrefix/Branch/Index">
                            <i class="fas fa-building"></i> Quản lý Chi nhánh
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Employee" ? "active" : "")">
                        <a href="#EmployeeSubmenu" data-bs-toggle="collapse" aria-expanded="false">
                            <i class="fas fa-users"></i> Quản lý nhân sự
                        </a>
                        <ul class="collapse list-unstyled" id="EmployeeSubmenu">
                            <li><a href="/@urlPrefix/Employee/Index">Nhân viên</a></li>
                            <li><a href="/@urlPrefix/WorkShift/SalaryReport">Lương thưởng</a></li>
                            <li><a href="/@urlPrefix/WorkShift/Index">Phân ca làm việc</a></li>
                        </ul>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Movie" ? "active" : "")">
                        <a href="#movieSubmenu" data-bs-toggle="collapse" aria-expanded="false">
                            <i class="fas fa-video"></i> Quản lý Phim
                        </a>
                        <ul class="collapse list-unstyled" id="movieSubmenu">
                            <li><a href="/@urlPrefix/Movies/Index">Thông Tin Phim</a></li>
                            <li><a href="/@urlPrefix/Movies/ChartMovie">Thống Kê Phim</a></li>
                        </ul>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "ScreeningRoom" ? "active" : "")">
                        <a href="#roomSubmenu" data-bs-toggle="collapse" aria-expanded="false">
                            <i class="fas fa-door-open"></i> Quản lý Phòng chiếu
                        </a>
                        <ul class="collapse list-unstyled" id="roomSubmenu">
                            <li>
                                <a href="/@urlPrefix/ScreeningRoom/Index">
                                    Danh sách phòng
                                </a>
                            </li>
                            <li>
                                <a href="/@urlPrefix/SeatManagement/Index"">
                                    Quản lý ghế ngồi
                                </a>
                            </li>
                        </ul>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "ShowTime" ? "active" : "")">
                        <a href="/@urlPrefix/ShowTime/Index">
                            <i class="fas fa-building"></i> Quản lý Suất chiếu
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")">
                        <a href="/@urlPrefix/Product/Index">
                            <i class="fas fa-users"></i> Quản lý sản phẩm
                        </a>
                    </li>
                    <li>
                        <a href="/@urlPrefix/EmployeeSale/Index">
                            <i class="fas fa-file-invoice"></i> Quản lý bán hàng
                        </a>
                    </li>
                </ul>
            }
            else if (role.Equals("EmployeeSales"))
            {
                <ul class="list-unstyled components">
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <a href="/@urlPrefix">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                    </li>
                    <li>
                        <a href="/@urlPrefix/EmployeeSale/Index">
                            <i class="fas fa-file-invoice"></i> Quản lý bán hàng
                        </a>
                    </li>
                    
                </ul>
            }
            else if (role.Equals("EmployeeTechnician"))
            {
                <ul class="list-unstyled components">
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <a href="/@urlPrefix">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "ScreeningRoom" ? "active" : "")">
                        <a href="#roomSubmenu" data-bs-toggle="collapse" aria-expanded="false">
                            <i class="fas fa-door-open"></i> Quản lý Phòng chiếu
                        </a>
                        <ul class="collapse list-unstyled" id="roomSubmenu">
                            <li>
                                <a href="/@urlPrefix/ScreeningRoom/Index">
                                    Danh sách phòng
                                </a>
                            </li>
                            <li>
                                <a href="/@urlPrefix/SeatManagement/Index">
                                    Quản lý ghế ngồi
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            }
            else if (role.Equals("EmployeeMovies"))
            {
                <ul class="list-unstyled components">
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <a href="/@urlPrefix">
                            <i class="fas fa-tachometer-alt"></i> Dashboard
                        </a>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Movie" ? "active" : "")">
                        <a href="#movieSubmenu" data-bs-toggle="collapse" aria-expanded="false">
                            <i class="fas fa-video"></i> Quản lý Phim
                        </a>
                        <ul class="collapse list-unstyled" id="movieSubmenu">
                            <li><a href="/@urlPrefix/Movies/Index">Thông Tin Phim</a></li>
                            <li><a href="/@urlPrefix/Movies/ChartMovie">Thống Kê Phim</a></li>
                        </ul>
                    </li>
                    <li class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "ShowTime" ? "active" : "")">
                        <a href="/@urlPrefix/ShowTime/Index">
                            <i class="fas fa-building"></i> Quản lý Suất chiếu
                        </a>
                    </li>
                </ul>
            }

            
            <ul class="list-unstyled mt-auto">
                <li>
                    <a asp-controller="Home" asp-action="Index" asp-area="">
                        <i class="fas fa-home"></i> Về trang chủ
                    </a>
                </li>
                <li>
                    <a href="/Account/Logout" onclick="return confirm('Bạn có chắc muốn đăng xuất?');">
                        <i class="fas fa-sign-out-alt"></i> Đăng xuất
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Page Content -->
        <div id="content">
            <!-- Top Navbar -->
            <nav class="navbar navbar-expand-lg navbar-light bg-light">
                <div class="container-fluid">
                    <button type="button" id="sidebarCollapse" class="btn btn-dark">
                        <i class="fas fa-bars"></i>
                    </button>

                    <div class="ms-auto d-flex align-items-center">
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user-circle fa-lg"></i> @employeeName
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" href="/Account/Profile"><i class="fas fa-user"></i> Thông tin</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" href="/Account/Logout"><i class="fas fa-sign-out-alt"></i> Đăng xuất</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <div class="container-fluid mt-4">
                <!-- Notification Messages -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        <i class="fas fa-check-circle"></i> @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Loading Overlay -->
    <div id="loadingOverlay" style="display: none;">
        <div class="loading-spinner">
            <div class="spinner"></div>
            <p>Đang xử lý...</p>
        </div>
    </div>
    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/Admin/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>