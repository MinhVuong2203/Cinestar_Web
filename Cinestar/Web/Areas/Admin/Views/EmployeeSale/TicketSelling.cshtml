@model Web.Models.Employee
@{
    ViewData["Title"] = "Bán vé";
    var movieId = ViewData["MovieId"] as string;
    var showTimes = ViewData["ShowTimes"] as IEnumerable<dynamic>;
    var ticketTypes = ViewData["TicketTypes"] as dynamic;
    var lstProducts = ViewData["lstProducts"] as List<Product>;
}
@section Styles {
    <link href="~/css/Admin/SaleTicket.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
}

<div class="booking-container">
    <div class="cinema-info">
        <h4><i class="fas fa-map-marker-alt"></i> Chi nhánh: <strong>@(Model.Branch?.BranchName)</strong></h4>
        <p class="mb-0"><i class="fas fa-user"></i> Nhân viên: <strong>@Model.FullName</strong></p>
        <p class="mb-0"><i class="fas fa-film"></i> Mã phim: <strong>@movieId</strong></p>
    </div>

    <!-- Bước 2: Chọn giờ xem -->
    <div class="step-card">
        <div class="step-header">
            <div class="step-number">2</div>
            <h3 class="step-title">Chọn giờ xem</h3>
        </div>
        <div class="time-grid" id="timeGrid">
            @* <form action="/EmployeeSale/GetRoomNameByMovieShowTimeDate" method="post"> *@
                @if (showTimes != null && showTimes.Any())
                {
                    <div class="row g-3">
                        @foreach (var showTime in showTimes)
                        {
                            var showTimeId = showTime.ShowTimeID;
                            var startTime = showTime.StartTime;
                            var roomName = showTime.RoomName;
                            var roomType = showTime.RoomType;
                            var availableSeats = showTime.AvailableSeats ?? 0;
                            var totalSeats = showTime.TotalSeats ?? 0;
                        
                            // Format time display
                            DateTime startDateTime = startTime is DateTime dt ? dt : DateTime.Parse(startTime.ToString());
                            string timeDisplay = startDateTime.ToString("HH:mm");

                            <div class="col-md-3 col-sm-4 col-6">
                                <div class="time-slot" 
                                     data-showtime-id="@showTimeId" 
                                     data-time="@timeDisplay" 
                                     data-room="@roomName">
                                    <div class="time-slot-time">@timeDisplay</div>
                                    <div class="time-slot-room">@roomName (@roomType)</div>
                                    <div class="time-slot-seats @(availableSeats < 10 ? "text-warning" : "text-success")">
                                        @availableSeats/@totalSeats ghế trống
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-showtimes text-center py-5">
                        <i class="fas fa-film fa-3x text-muted mb-3"></i>
                        <p class="text-muted">Không có suất chiếu nào cho ngày hôm nay. Vui lòng chọn ngày khác.</p>
                    </div>
                }
            @* </form> *@
        </div>
    </div>


    <!-- Bước 3: Chọn loại vé -->
    <div class="step-card hidden" id="step3">
        <div class="step-header">
            <div class="step-number">3</div>
            <h3 class="step-title">Chọn loại vé</h3>
        </div>
        <div id="ticketOptions">
            @if (ticketTypes != null)
            {
                <div class="ticket-wr">
                    <h2 class="heading">CHỌN LOẠI VÉ</h2>
                    <div class="ticket-container">
                        @* Vé Thường *@
                        @if (ticketTypes.Standard != null)
                        {
                            <div class="content"
                                 data-ticket-type="standard"
                                 data-price="@ticketTypes.Standard.Price"
                                 data-available="@ticketTypes.Standard.AvailableCount">
                                <div class="content-top">
                                    <p class="name">
                                        <i class="@ticketTypes.Standard.Icon"></i>
                                        @ticketTypes.Standard.Name
                                    </p>
                                    <div class="desc">
                                        <p>@ticketTypes.Standard.Description</p>
                                        <p class="text-muted small">Còn lại: @ticketTypes.Standard.AvailableCount vé</p>
                                    </div>
                                    <div class="price">
                                        <p>@ticketTypes.Standard.Price.ToString("N0") VNĐ</p>
                                    </div>
                                </div>
                                <div class="content-bottom">
                                    <div class="count">
                                        <div class="count-btn">
                                            <button class="decrease">-</button>
                                            <span class="quantity">0</span>
                                            <button class="increase">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @* Vé VIP *@
                        @if (ticketTypes.VIP != null)
                        {
                            <div class="content"
                                 data-ticket-type="vip"
                                 data-price="@ticketTypes.VIP.Price"
                                 data-available="@ticketTypes.VIP.AvailableCount">
                                <div class="content-top">
                                    <p class="name">
                                        <i class="@ticketTypes.VIP.Icon"></i>
                                        @ticketTypes.VIP.Name
                                    </p>
                                    <div class="desc">
                                        <p>@ticketTypes.VIP.Description</p>
                                        <p class="text-muted small">Còn lại: @ticketTypes.VIP.AvailableCount vé</p>
                                    </div>
                                    <div class="price">
                                        <p>@ticketTypes.VIP.Price.ToString("N0") VNĐ</p>
                                    </div>
                                </div>
                                <div class="content-bottom">
                                    <div class="count">
                                        <div class="count-btn">
                                            <button class="decrease">-</button>
                                            <span class="quantity">0</span>
                                            <button class="increase">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @* Vé Đôi *@
                        @if (ticketTypes.Couple != null)
                        {
                            <div class="content"
                                 data-ticket-type="couple"
                                 data-price="@ticketTypes.Couple.Price"
                                 data-available="@ticketTypes.Couple.AvailableCount">
                                <div class="content-top">
                                    <p class="name">
                                        <i class="@ticketTypes.Couple.Icon"></i>
                                        @ticketTypes.Couple.Name
                                    </p>
                                    <div class="desc">
                                        <p>@ticketTypes.Couple.Description</p>
                                        <p class="text-muted small">Còn lại: @ticketTypes.Couple.AvailableCount vé</p>
                                    </div>
                                    <div class="price">
                                        <p>@ticketTypes.Couple.Price.ToString("N0") VNĐ</p>
                                    </div>
                                </div>
                                <div class="content-bottom">
                                    <div class="count">
                                        <div class="count-btn">
                                            <button class="decrease">-</button>
                                            <span class="quantity">0</span>
                                            <button class="increase">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <i class="fas fa-exclamation-triangle"></i>
                    Không có thông tin loại vé. Vui lòng liên hệ quản trị viên.
                </div>
            }
        </div>
    </div>

