@model Web.Models.Employee
@{
    ViewData["Title"] = "Bán vé";
    var movieId = ViewData["MovieId"] as string;
}
@section Styles {
    <link href="~/css/Admin/SaleTicket.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
}

<div class="booking-container">
    <div class="cinema-info">
        <h4><i class="fas fa-map-marker-alt"></i> Chi nhánh: <strong>@(Model.Branch?.BranchName)</strong></h4>
        <p class="mb-0"><i class="fas fa-user"></i> Nhân viên: <strong>@Model.FullName</strong></p>
        <p class="mb-0"><i class="fas fa-film"></i> Mã phim: <strong>@movieId</strong></p>
    </div>
    <!--movieId-->
    <!-- Bước 2: Chọn giờ xem -->
    <div class="step-card">
        <div class="step-header">
            <div class="step-number">2</div>
            <h3 class="step-title">Chọn giờ xem</h3>
        </div>
        <div class="mb-3">
            <label class="form-label"><i class="fas fa-calendar"></i> Chọn ngày:</label>
            <input type="date" class="form-control" id="dateSelect" data-movie-id ="@movieId" min="">
        </div>
        <div class="time-grid" id="timeGrid">
            <div class="loading-message text-center py-4">
                <i class="fas fa-spinner fa-spin fa-2x"></i>
                <p class="mt-2">Vui lòng chọn ngày để xem suất chiếu...</p>
            </div>
        </div>
    </div>

    <!-- Bước 3: Chọn loại vé -->
    <div class="step-card hidden" id="step3">
        <div class="step-header">
            <div class="step-number">3</div>
            <h3 class="step-title">Chọn loại vé</h3>
        </div>
        <div id="ticketOptions">
            <div class="loading-message text-center py-4">
                <i class="fas fa-spinner fa-spin fa-2x"></i>
                <p class="mt-2">Đang tải thông tin vé...</p>
            </div>
        </div>
    </div>

    <!-- Bước 4: Chọn bắp nước -->
    <div class="step-card hidden" id="step4">
        <div class="step-header">
            <div class="step-number">4</div>
            <h3 class="step-title">Chọn bắp nước (Tùy chọn)</h3>
        </div>
        <div class="combo-item" data-combo="combo1" data-price="70000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-box"></i> Combo 1</h5>
                    <p class="text-muted mb-0">1 Bắp lớn + 1 Nước lớn</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">70.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeComboQuantity('combo1', -1)">-</button>
                        <span class="quantity-value" id="combo-combo1">0</span>
                        <button class="quantity-btn" onclick="changeComboQuantity('combo1', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="combo-item" data-combo="combo2" data-price="120000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-box"></i> Combo 2</h5>
                    <p class="text-muted mb-0">2 Bắp lớn + 2 Nước lớn</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">120.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeComboQuantity('combo2', -1)">-</button>
                        <span class="quantity-value" id="combo-combo2">0</span>
                        <button class="quantity-btn" onclick="changeComboQuantity('combo2', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="combo-item" data-combo="popcorn" data-price="45000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-popcorn"></i> Bắp rang</h5>
                    <p class="text-muted mb-0">1 Bắp lớn</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">45.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeComboQuantity('popcorn', -1)">-</button>
                        <span class="quantity-value" id="combo-popcorn">0</span>
                        <button class="quantity-btn" onclick="changeComboQuantity('popcorn', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="combo-item" data-combo="drink" data-price="30000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-glass-water"></i> Nước ngọt</h5>
                    <p class="text-muted mb-0">1 Nước lớn</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">30.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeComboQuantity('drink', -1)">-</button>
                        <span class="quantity-value" id="combo-drink">0</span>
                        <button class="quantity-btn" onclick="changeComboQuantity('drink', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tổng kết đơn hàng -->
    <div class="summary-box hidden" id="summaryBox">
        <h4><i class="fas fa-receipt"></i> Tổng kết đơn hàng</h4>
        <div class="summary-row">
            <span>Phim:</span>
            <span id="summary-movie">-</span>
        </div>
        <div class="summary-row">
            <span>Ngày giờ:</span>
            <span id="summary-datetime">-</span>
        </div>
        <div class="summary-row">
            <span>Loại vé:</span>
            <span id="summary-tickets">-</span>
        </div>
        <div class="summary-row">
            <span>Bắp nước:</span>
            <span id="summary-combos">Không có</span>
        </div>
        <div class="summary-row total-row">
            <span>TỔNG CỘNG:</span>
            <span id="summary-total">0 ₫</span>
        </div>
        <button class="btn-book" onclick="confirmBooking()">
            <i class="fas fa-check-circle"></i> XÁC NHẬN ĐẶT VÉ
        </button>
    </div>
</div>

<script>
    const movieId = '@ViewData["MovieId"]';
</script>
<script src="/js/Admin/TicketSelling.js?v=@DateTime.Now.Ticks"></script>