@model Web.Models.Employee
@{
    ViewData["Title"] = "Bán vé";
    var movieId = ViewData["MovieId"] as string;
    var showTimes = ViewData["ShowTimes"] as IEnumerable<dynamic>;
    // var ticketTypes = ViewData["TicketTypes"] as dynamic;
    var lstProducts = ViewData["lstProducts"] as List<Product>;
}
@section Styles {
    <link href="~/css/Admin/SaleTicket.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
}

<div class="booking-container">
    <div class="cinema-info">
        <h4><i class="fas fa-map-marker-alt"></i> Chi nhánh: <strong>@(Model.Branch?.BranchName)</strong></h4>
        <p class="mb-0"><i class="fas fa-user"></i> Nhân viên: <strong>@Model.FullName</strong></p>
        <p class="mb-0"><i class="fas fa-film"></i> Mã phim: <strong>@movieId</strong></p>
    </div>

    <!-- Bước 2: Chọn giờ xem -->
    <div class="step-card">
        <div class="step-header">
            <div class="step-number">2</div>
            <h3 class="step-title">Chọn giờ xem</h3>
        </div>
        <div class="time-grid" id="timeGrid">
            @* <form action="/EmployeeSale/GetRoomNameByMovieShowTimeDate" method="post"> *@
                @if (showTimes != null && showTimes.Any())
                {
                    <div class="row g-3">
                        @foreach (var showTime in showTimes)
                        {
                            var showTimeId = showTime.ShowTimeID;
                            var startTime = showTime.StartTime;
                            var roomName = showTime.RoomName;
                            var roomType = showTime.RoomType;
                            var availableSeats = showTime.AvailableSeats ?? 0;
                            var totalSeats = showTime.TotalSeats ?? 0;
                        
                            // Format time display
                            DateTime startDateTime = startTime is DateTime dt ? dt : DateTime.Parse(startTime.ToString());
                            string timeDisplay = startDateTime.ToString("HH:mm");

                            <div class="col-md-3 col-sm-4 col-6">
                                <div class="time-slot"
                                     data-showtime-id="@showTimeId"
                                     data-time="@timeDisplay"
                                     data-room="@roomName"
                                     data-room-type="@roomType"
                                     data-movie-id="@movieId"
                                     data-branch-id="@Model.BranchID">
                                    <div class="time-slot-time">@timeDisplay</div>
                                    <div class="time-slot-room">@roomName (@roomType)</div>
                                    <div class="time-slot-seats @(availableSeats < 10 ? "text-warning" : "text-success")">
                                        @availableSeats/@totalSeats ghế trống
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="no-showtimes text-center py-5">
                        <i class="fas fa-film fa-3x text-muted mb-3"></i>
                        <p class="text-muted">Không có suất chiếu nào cho ngày hôm nay. Vui lòng chọn ngày khác.</p>
                    </div>
                }
            @* </form> *@
        </div>
    </div>


    <!-- Bước 3: Chọn loại vé -->
    <div class="step-card hidden" id="step3">
        <div class="step-header">
            <div class="step-number">3</div>
            <h3 class="step-title">Chọn loại vé</h3>
        </div>
        <div id="ticketOptions">
            <!-- Ticket types sẽ được load động từ JavaScript -->
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-3 text-muted">Đang tải thông tin vé...</p>
            </div>
        </div>
    </div>

    <!--Bước 4: chọn ghế-->
    <div class="step-card" id="step5">

        <h1 class="TitleBrand" id="roomTitle">Chọn ghế - </h1>
    <div style="position: relative;">
        <img src="~/image/img-screen.png" class="screen">
        <div class="screen-label">Màn hình</div>

    </div>

    <div class="seating-area">
        <table id="seatingTable">
            
        </table>
    </div>

    <div class="legend">
        <div class="legend-item">
            <div class="legend-box regular"></div>
            <span>Ghế Thường</span>
        </div>
        <div class="legend-item">
            <div class="legend-box couple"></div>
            <span>Ghế Đôi (2 Người)</span>
        </div>
        <div class="legend-item">
            <div class="legend-box selected"></div>
            <span>Ghế chọn</span>
        </div>
        <div class="legend-item">
            <div class="legend-box booked"></div>
            <span>Ghế đã đặt</span>
        </div>
    </div>
    </div>

    <!-- Bước 5: Chọn bắp nước -->
    <div class="step-card hidden" id="step4">
        <div class="step-header">
            <div class="step-number">5</div>
            <h3 class="step-title">Chọn bắp nước (Tùy chọn)</h3>
        </div>

        @if (lstProducts != null && lstProducts.Any())
        {
            foreach (var product in lstProducts)
            {
                <div class="combo-item"
                     data-combo-id="@product.ProductID"
                     data-combo-name="@product.ProductName"
                     data-combo-type="@product.ProductType"
                     data-price="@product.Price">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="product-info">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.ProductName" class="product-image" />
                            }
                            <div>
                                <h5><i class="fas fa-box"></i> @product.ProductName</h5>
                                <p class="text-muted mb-0">@product.ProductType</p>
                            </div>
                        </div>
                        <div class="text-end">
                            <h4 class="text-primary mb-0">@product.Price?.ToString("N0") ₫</h4>
                            <div class="quantity-control mt-2">
                                <button class="quantity-btn" onclick="changeComboQuantity('@product.ProductID', -1)">-</button>
                                <span class="quantity-value" id="combo-@product.ProductID">0</span>
                                <button class="quantity-btn" onclick="changeComboQuantity('@product.ProductID', 1)">+</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info text-center">
                <i class="fas fa-info-circle"></i>
                Hiện tại không có sản phẩm nào.
            </div>
        }
    </div>

    

    <!-- Tổng kết đơn hàng -->
    <div class="summary-box hidden" id="summaryBox">
        <h4><i class="fas fa-receipt"></i> Tổng kết đơn hàng</h4>
        <div class="summary-row">
            <span>Phim:</span>
            <span id="summary-movie">-</span>
        </div>
        <div class="summary-row">
            <span>Ngày giờ:</span>
            <span id="summary-datetime">-</span>
        </div>
        <div class="summary-row">
            <span>Loại vé:</span>
            <span id="summary-tickets">-</span>
        </div>
        <div class="summary-row">
            <span>Bắp nước:</span>
            <span id="summary-combos">Không có</span>
        </div>
        <div class="summary-row total-row">
            <span>TỔNG CỘNG:</span>
            <span id="summary-total">0 ₫</span>
        </div>
        <button class="btn-book" onclick="confirmBooking()">
            <i class="fas fa-check-circle"></i> XÁC NHẬN ĐẶT VÉ
        </button>
    </div>
</div>

<script>
    const movieId = '@movieId';
    const initialShowTimes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(showTimes ?? new List<dynamic>()));
</script>
<script src="/js/Admin/TicketSelling.js?v=@DateTime.Now.Ticks"></script>