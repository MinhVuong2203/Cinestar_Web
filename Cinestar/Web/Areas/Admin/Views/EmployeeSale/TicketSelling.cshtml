@model Web.Models.Employee
@{
    ViewData["Title"] = "Bán vé";
    var movieId = ViewData["MovieId"] as string;
    var showTimes = ViewData["ShowTimes"] as IEnumerable<dynamic>;
	var ticketTypes = ViewData["TicketTypes"] as dynamic;
}
@section Styles {
    <link href="~/css/Admin/SaleTicket.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
}

<div class="booking-container">
    <div class="cinema-info">
        <h4><i class="fas fa-map-marker-alt"></i> Chi nhánh: <strong>@(Model.Branch?.BranchName)</strong></h4>
        <p class="mb-0"><i class="fas fa-user"></i> Nhân viên: <strong>@Model.FullName</strong></p>
        <p class="mb-0"><i class="fas fa-film"></i> Mã phim: <strong>@movieId</strong></p>
    </div>

    <!-- Bước 2: Chọn giờ xem -->
    <div class="step-card">
        <div class="step-header">
            <div class="step-number">2</div>
            <h3 class="step-title">Chọn giờ xem</h3>
        </div>
        <div class="time-grid" id="timeGrid">
            @if (showTimes != null && showTimes.Any())
            {
                <div class="row g-3">
                    @foreach (var showTime in showTimes)
                    {
                        var showTimeId = showTime.ShowTimeID;
                        var startTime = showTime.StartTime;
                        var roomName = showTime.RoomName;
                        var roomType = showTime.RoomType;
                        var availableSeats = showTime.AvailableSeats ?? 0;
                        var totalSeats = showTime.TotalSeats ?? 0;
                        
                        // Format time display
                        DateTime startDateTime = startTime is DateTime dt ? dt : DateTime.Parse(startTime.ToString());
                        string timeDisplay = startDateTime.ToString("HH:mm");

                        <div class="col-md-3 col-sm-4 col-6">
                            <div class="time-slot" 
                                 data-showtime-id="@showTimeId" 
                                 data-time="@timeDisplay" 
                                 data-room="@roomName">
                                <div class="time-slot-time">@timeDisplay</div>
                                <div class="time-slot-room">@roomName (@roomType)</div>
                                <div class="time-slot-seats @(availableSeats < 10 ? "text-warning" : "text-success")">
                                    @availableSeats/@totalSeats ghế trống
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-showtimes text-center py-5">
                    <i class="fas fa-film fa-3x text-muted mb-3"></i>
                    <p class="text-muted">Không có suất chiếu nào cho ngày hôm nay. Vui lòng chọn ngày khác.</p>
                </div>
            }
        </div>
    </div>


    <!-- Bước 3: Chọn loại vé -->
    <div class="step-card hidden" id="step3">
        <div class="step-header">
            <div class="step-number">3</div>
            <h3 class="step-title">Chọn loại vé</h3>
        </div>
        <div id="ticketOptions">
            @if (ticketTypes != null)
            {
                <div class="ticket-wr">
                    <h2 class="heading">CHỌN LOẠI VÉ</h2>
                    <div class="ticket-container">
                        @* Vé Thường *@
                        @if (ticketTypes.Standard != null)
                        {
                            <div class="content"
                                 data-ticket-type="standard"
                                 data-price="@ticketTypes.Standard.Price"
                                 data-available="@ticketTypes.Standard.AvailableCount">
                                <div class="content-top">
                                    <p class="name">
                                        <i class="@ticketTypes.Standard.Icon"></i>
                                        @ticketTypes.Standard.Name
                                    </p>
                                    <div class="desc">
                                        <p>@ticketTypes.Standard.Description</p>
                                        <p class="text-muted small">Còn lại: @ticketTypes.Standard.AvailableCount vé</p>
                                    </div>
                                    <div class="price">
                                        <p>@ticketTypes.Standard.Price.ToString("N0") VNĐ</p>
                                    </div>
                                </div>
                                <div class="content-bottom">
                                    <div class="count">
                                        <div class="count-btn">
                                            <button class="decrease">-</button>
                                            <span class="quantity">0</span>
                                            <button class="increase">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @* Vé VIP *@
                        @if (ticketTypes.VIP != null)
                        {
                            <div class="content"
                                 data-ticket-type="vip"
                                 data-price="@ticketTypes.VIP.Price"
                                 data-available="@ticketTypes.VIP.AvailableCount">
                                <div class="content-top">
                                    <p class="name">
                                        <i class="@ticketTypes.VIP.Icon"></i>
                                        @ticketTypes.VIP.Name
                                    </p>
                                    <div class="desc">
                                        <p>@ticketTypes.VIP.Description</p>
                                        <p class="text-muted small">Còn lại: @ticketTypes.VIP.AvailableCount vé</p>
                                    </div>
                                    <div class="price">
                                        <p>@ticketTypes.VIP.Price.ToString("N0") VNĐ</p>
                                    </div>
                                </div>
                                <div class="content-bottom">
                                    <div class="count">
                                        <div class="count-btn">
                                            <button class="decrease">-</button>
                                            <span class="quantity">0</span>
                                            <button class="increase">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }

                        @* Vé Đôi *@
                        @if (ticketTypes.Couple != null)
                        {
                            <div class="content"
                                 data-ticket-type="couple"
                                 data-price="@ticketTypes.Couple.Price"
                                 data-available="@ticketTypes.Couple.AvailableCount">
                                <div class="content-top">
                                    <p class="name">
                                        <i class="@ticketTypes.Couple.Icon"></i>
                                        @ticketTypes.Couple.Name
                                    </p>
                                    <div class="desc">
                                        <p>@ticketTypes.Couple.Description</p>
                                        <p class="text-muted small">Còn lại: @ticketTypes.Couple.AvailableCount vé</p>
                                    </div>
                                    <div class="price">
                                        <p>@ticketTypes.Couple.Price.ToString("N0") VNĐ</p>
                                    </div>
                                </div>
                                <div class="content-bottom">
                                    <div class="count">
                                        <div class="count-btn">
                                            <button class="decrease">-</button>
                                            <span class="quantity">0</span>
                                            <button class="increase">+</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    <i class="fas fa-exclamation-triangle"></i>
                    Không có thông tin loại vé. Vui lòng liên hệ quản trị viên.
                </div>
            }
        </div>
    </div>

    <!-- Bước 4: Chọn bắp nước -->
    <div class="step-card hidden" id="step4">
        <div class="step-header">
            <div class="step-number">4</div>
            <h3 class="step-title">Chọn bắp nước (Tùy chọn)</h3>
        </div>
        <div class="combo-item" data-combo="combo1" data-price="70000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-box"></i> Combo 1</h5>
                    <p class="text-muted mb-0">1 Bắp lớn + 1 Nước lớn</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">70.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeComboQuantity('combo1', -1)">-</button>
                        <span class="quantity-value" id="combo-combo1">0</span>
                        <button class="quantity-btn" onclick="changeComboQuantity('combo1', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="combo-item" data-combo="combo2" data-price="120000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-box"></i> Combo 2</h5>
                    <p class="text-muted mb-0">2 Bắp lớn + 2 Nước lớn</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">120.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeComboQuantity('combo2', -1)">-</button>
                        <span class="quantity-value" id="combo-combo2">0</span>
                        <button class="quantity-btn" onclick="changeComboQuantity('combo2', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="combo-item" data-combo="popcorn" data-price="45000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-popcorn"></i> Bắp rang</h5>
                    <p class="text-muted mb-0">1 Bắp lớn</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">45.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeComboQuantity('popcorn', -1)">-</button>
                        <span class="quantity-value" id="combo-popcorn">0</span>
                        <button class="quantity-btn" onclick="changeComboQuantity('popcorn', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="combo-item" data-combo="drink" data-price="30000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-glass-water"></i> Nước ngọt</h5>
                    <p class="text-muted mb-0">1 Nước lớn</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">30.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeComboQuantity('drink', -1)">-</button>
                        <span class="quantity-value" id="combo-drink">0</span>
                        <button class="quantity-btn" onclick="changeComboQuantity('drink', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tổng kết đơn hàng -->
    <div class="summary-box hidden" id="summaryBox">
        <h4><i class="fas fa-receipt"></i> Tổng kết đơn hàng</h4>
        <div class="summary-row">
            <span>Phim:</span>
            <span id="summary-movie">-</span>
        </div>
        <div class="summary-row">
            <span>Ngày giờ:</span>
            <span id="summary-datetime">-</span>
        </div>
        <div class="summary-row">
            <span>Loại vé:</span>
            <span id="summary-tickets">-</span>
        </div>
        <div class="summary-row">
            <span>Bắp nước:</span>
            <span id="summary-combos">Không có</span>
        </div>
        <div class="summary-row total-row">
            <span>TỔNG CỘNG:</span>
            <span id="summary-total">0 ₫</span>
        </div>
        <button class="btn-book" onclick="confirmBooking()">
            <i class="fas fa-check-circle"></i> XÁC NHẬN ĐẶT VÉ
        </button>
    </div>
</div>

<script>
    const movieId = '@movieId';
    const initialShowTimes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(showTimes ?? new List<dynamic>()));
</script>
<script src="/js/Admin/TicketSelling.js?v=@DateTime.Now.Ticks"></script>