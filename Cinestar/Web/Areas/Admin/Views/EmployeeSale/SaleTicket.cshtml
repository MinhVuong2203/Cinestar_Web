@model Web.Models.Employee
@{
	ViewData["Title"] = "Bán vé";
    var lstMovies = ViewData["lstMovies"] as List<Movie>;
}
@section Styles {
    <link href="~/css/Admin/SaleTicket.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
}
<div class="booking-container">
    <div class="cinema-info">
        <h4><i class="fas fa-map-marker-alt"></i> Chi nhánh: <strong>@(Model.Branch?.BranchName)</strong></h4>
        <p class="mb-0"><i class="fas fa-user"></i> Nhân viên: <strong>@Model.FullName</strong></p>
    </div>

    <!-- Bước 1: Chọn phim -->
    <div class="step-card">
        <div class="step-header">
            <div class="step-number">1</div>
            <h3 class="step-title">Chọn phim</h3>
        </div>
        <div class="movie-grid" id="movieGrid">
            @if (lstMovies != null && lstMovies.Any())
            {
                @foreach (var movie in lstMovies)
                {
                    <div class="movie-card" data-movie="@movie.MovieID" data-name="@movie.Title">
                        <div class="movie-poster">
                            @if (!string.IsNullOrEmpty(movie.ImageUrl))
                            {
                                <img src="@movie.ImageUrl" alt="@movie.Title" class="movie-image" />
                            }
                            else
                            {
                                <i class="fas fa-film fa-4x text-white"></i>
                            }
                        </div>
                        <h5>@movie.Title</h5>
                        <p class="text-muted mb-0">@movie.Genre • @movie.DurationMinutes phút</p>
                        <span class="badge-custom">@movie.AgeLimit</span>
                    </div>
                }
            }
            else
            {
                <div class="no-movies">
                    <i class="fas fa-exclamation-circle fa-3x text-muted"></i>
                    <p class="text-muted mt-3">Không có phim nào đang chiếu tại chi nhánh này</p>
                </div>
            }
        </div>
    </div>

    <!-- Bước 2: Chọn loại vé -->
    <div class="step-card hidden" id="step2">
        <div class="step-header">
            <div class="step-number">2</div>
            <h3 class="step-title">Chọn loại vé</h3>
        </div>
        <div class="ticket-option" data-type="standard" data-price="80000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-ticket-alt"></i> Vé thường</h5>
                    <p class="text-muted mb-0">Ghế thường</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">80.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeQuantity('standard', -1)">-</button>
                        <span class="quantity-value" id="qty-standard">0</span>
                        <button class="quantity-btn" onclick="changeQuantity('standard', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="ticket-option" data-type="vip" data-price="120000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-crown"></i> Vé VIP</h5>
                    <p class="text-muted mb-0">Ghế VIP cao cấp</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">120.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeQuantity('vip', -1)">-</button>
                        <span class="quantity-value" id="qty-vip">0</span>
                        <button class="quantity-btn" onclick="changeQuantity('vip', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="ticket-option" data-type="couple" data-price="200000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-heart"></i> Vé đôi</h5>
                    <p class="text-muted mb-0">Ghế đôi couple</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">200.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeQuantity('couple', -1)">-</button>
                        <span class="quantity-value" id="qty-couple">0</span>
                        <button class="quantity-btn" onclick="changeQuantity('couple', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bước 3: Chọn giờ xem -->
    <div class="step-card hidden" id="step3">
        <div class="step-header">
            <div class="step-number">3</div>
            <h3 class="step-title">Chọn giờ xem</h3>
        </div>
        <div class="mb-3">
            <label class="form-label"><i class="fas fa-calendar"></i> Chọn ngày:</label>
            <input type="date" class="form-control" id="dateSelect" min="">
        </div>
        <div class="time-grid" id="timeGrid">
            <div class="time-slot" data-time="09:00">
                <h5>09:00</h5>
                <small class="text-muted">Phòng 1</small>
            </div>
            <div class="time-slot" data-time="11:30">
                <h5>11:30</h5>
                <small class="text-muted">Phòng 2</small>
            </div>
            <div class="time-slot" data-time="14:00">
                <h5>14:00</h5>
                <small class="text-muted">Phòng 1</small>
            </div>
            <div class="time-slot" data-time="16:30">
                <h5>16:30</h5>
                <small class="text-muted">Phòng 3</small>
            </div>
            <div class="time-slot" data-time="19:00">
                <h5>19:00</h5>
                <small class="text-muted">Phòng 2</small>
            </div>
            <div class="time-slot" data-time="21:30">
                <h5>21:30</h5>
                <small class="text-muted">Phòng 1</small>
            </div>
        </div>
    </div>

    <!-- Bước 4: Chọn bắp nước -->
    <div class="step-card hidden" id="step4">
        <div class="step-header">
            <div class="step-number">4</div>
            <h3 class="step-title">Chọn bắp nước (Tùy chọn)</h3>
        </div>
        <div class="combo-item" data-combo="combo1" data-price="70000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-box"></i> Combo 1</h5>
                    <p class="text-muted mb-0">1 Bắp lớn + 1 Nước lớn</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">70.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeComboQuantity('combo1', -1)">-</button>
                        <span class="quantity-value" id="combo-combo1">0</span>
                        <button class="quantity-btn" onclick="changeComboQuantity('combo1', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="combo-item" data-combo="combo2" data-price="120000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-box"></i> Combo 2</h5>
                    <p class="text-muted mb-0">2 Bắp lớn + 2 Nước lớn</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">120.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeComboQuantity('combo2', -1)">-</button>
                        <span class="quantity-value" id="combo-combo2">0</span>
                        <button class="quantity-btn" onclick="changeComboQuantity('combo2', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="combo-item" data-combo="popcorn" data-price="45000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-popcorn"></i> Bắp rang</h5>
                    <p class="text-muted mb-0">1 Bắp lớn</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">45.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeComboQuantity('popcorn', -1)">-</button>
                        <span class="quantity-value" id="combo-popcorn">0</span>
                        <button class="quantity-btn" onclick="changeComboQuantity('popcorn', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="combo-item" data-combo="drink" data-price="30000">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5><i class="fas fa-glass-water"></i> Nước ngọt</h5>
                    <p class="text-muted mb-0">1 Nước lớn</p>
                </div>
                <div class="text-end">
                    <h4 class="text-primary mb-0">30.000 ₫</h4>
                    <div class="quantity-control mt-2">
                        <button class="quantity-btn" onclick="changeComboQuantity('drink', -1)">-</button>
                        <span class="quantity-value" id="combo-drink">0</span>
                        <button class="quantity-btn" onclick="changeComboQuantity('drink', 1)">+</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tổng kết đơn hàng -->
    <div class="summary-box hidden" id="summaryBox">
        <h4><i class="fas fa-receipt"></i> Tổng kết đơn hàng</h4>
        <div class="summary-row">
            <span>Phim:</span>
            <span id="summary-movie">-</span>
        </div>
        <div class="summary-row">
            <span>Ngày giờ:</span>
            <span id="summary-datetime">-</span>
        </div>
        <div class="summary-row">
            <span>Loại vé:</span>
            <span id="summary-tickets">-</span>
        </div>
        <div class="summary-row">
            <span>Bắp nước:</span>
            <span id="summary-combos">Không có</span>
        </div>
        <div class="summary-row total-row">
            <span>TỔNG CỘNG:</span>
            <span id="summary-total">0 ₫</span>
        </div>
        <button class="btn-book" onclick="confirmBooking()">
            <i class="fas fa-check-circle"></i> XÁC NHẬN ĐẶT VÉ
        </button>
    </div>
</div>
<script src="/js/Admin/SaleTicket.js?v=@DateTime.Now.Ticks"></script>