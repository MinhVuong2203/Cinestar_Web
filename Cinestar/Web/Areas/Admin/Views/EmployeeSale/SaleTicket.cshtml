@model Web.Models.Employee
@{
    ViewData["Title"] = "Bán vé";
    var lstMovies = ViewData["lstMovies"] as List<Movie>;
}
@section Styles {
    <link href="~/css/Admin/SaleTicket.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
}

@* Hiển thị thông báo nếu không có phim *@
@if (!string.IsNullOrEmpty(ViewBag.NoMoviesMessage as string))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="fas fa-info-circle"></i> @ViewBag.NoMoviesMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="booking-container">
    <div class="cinema-info">
        <h4><i class="fas fa-map-marker-alt"></i> Chi nhánh: <strong>@(Model.Branch?.BranchName)</strong></h4>
        <p class="mb-0"><i class="fas fa-user"></i> Nhân viên: <strong>@Model.FullName</strong></p>
    </div>

    <!-- Bước 1: Chọn phim -->
    <div class="step-card">
        <div class="step-header">
            <div class="step-number">1</div>
            <h3 class="step-title">Chọn phim</h3>
        </div>
        <div class="movie-grid" id="movieGrid">
            @if (lstMovies != null && lstMovies.Any())
            {
                @foreach (var movie in lstMovies)
                {
                    <div class="movie-card" data-movie="@movie.MovieID" data-name="@movie.Title">
                        <div class="movie-poster">
                            @if (!string.IsNullOrEmpty(movie.ImageUrl))
                            {
                                <img src="@movie.ImageUrl" alt="@movie.Title" class="movie-image" />
                            }
                            else
                            {
                                <i class="fas fa-film fa-4x text-white"></i>
                            }
                        </div>
                        <h5>@movie.Title</h5>
                        <p class="text-muted mb-0">@movie.Genre • @movie.DurationMinutes phút</p>
                        <span class="badge-custom">@movie.AgeLimit</span>
                        <!--Nút đặt vé-->
                        <a asp-area="Admin" 
                          asp-controller="EmployeeSale" 
                          asp-action="TicketSelling" 
                          asp-route-movieId="@movie.MovieID" 
                          class="btn btn-primary btn-book"
                          data-movie-id="@movie.MovieID">
                            Đặt vé
                        </a>
                        @* Debug: Hiển thị MovieID *@
                        <small class="text-muted d-block mt-1">ID: @movie.MovieID</small>
                    </div>
                }
            }
            else
            {
                <div class="no-movies">
                    <i class="fas fa-exclamation-circle fa-3x text-muted"></i>
                    <p class="text-muted mt-3">Không có phim nào đang chiếu tại chi nhánh này</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        console.log('=== SaleTicket Page Loaded ===');
        
        document.addEventListener('DOMContentLoaded', function() {
          const links = document.querySelectorAll('.btn-book');
  console.log('Found links:', links.length);
       
   links.forEach((link, index) => {
     const movieId = link.getAttribute('data-movie-id');
 const href = link.getAttribute('href');
     
    console.log(`Link ${index}:`);
   console.log(`  - href: ${href}`);
                console.log(`  - data-movie-id: ${movieId}`);
   console.log(`  - full link object:`, link);
    
           // Test click
     link.addEventListener('click', function(e) {
    console.log('=== Link Clicked ===');
        console.log('  - this.href:', this.href);
     console.log('  - data-movie-id:', this.getAttribute('data-movie-id'));
      console.log('  - Event:', e);
     
          // Không preventDefault - để link hoạt động
       });
     });
   
            // Thêm test: Tạo URL thủ công
   if (links.length > 0) {
  const firstLink = links[0];
      const movieId = firstLink.getAttribute('data-movie-id');
       const manualUrl = `/Admin/EmployeeSale/TicketSelling?movieId=${encodeURIComponent(movieId)}`;
       console.log('Manual URL would be:', manualUrl);
      }
  });
    </script>
}

<script src="/js/Admin/SaleTicket.js?v=@DateTime.Now.Ticks"></script>