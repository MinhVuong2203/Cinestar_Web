@model Web.Models.CinemaBranch

@{
    ViewData["Title"] = "Sửa Chi nhánh";
}
@section styles {
    <link href="~/css/Admin/Branch.css" rel="stylesheet" />
}

<div class="row mb-3">
    <div class="col-md-12">
        <h2><i class="fas fa-plus"></i> Cập nhật chi nhánh</h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-action="Index">Quản lý Chi nhánh</a>
                </li>
                <li class="breadcrumb-item active">Sửa: @Model.BranchName</li>
            </ol>
        </nav>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-building"></i> Thông tin Chi nhánh
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.BranchID" method="post" enctype="multipart/form-data">

                    <input type="hidden" asp-for="BranchID" />
                    <input type="hidden" asp-for="IsDeleted" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="BranchName" class="form-label">Tên chi nhánh</label>
                            <input asp-for="BranchName" class="form-control" placeholder="Ví dụ: Cinestar Quốc Thanh" />
                            <span asp-validation-for="BranchName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Số điện thoại</label>
                            <input asp-for="Phone" class="form-control" placeholder="Ví dụ: 0901234567" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label">Thành phố</label>
                            <select asp-for="City" id="CitySelect" name="City" class="form-select">
                                <option value="">-- Chọn Thành phố --</option>
                            </select>
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="District" class="form-label">Huyện</label>
                            <select  id="DistrictSelect" name="District" class="form-select" disabled>
                                <option value="">-- Chọn Quận/Huyện --</option>
                            </select>
                            <span asp-validation-for="District" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Address" class="form-label">Địa chỉ</label>
                        <input asp-for="Address" class="form-control" placeholder="Ví dụ: 271 Nguyễn Trãi, Phường Nguyễn Cư Trinh" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="branch@cinestar.com.vn" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="OpenHour" class="form-label">Giờ mở cửa</label>
                            <input asp-for="OpenHour" type="time" class="form-control" />
                            <span asp-validation-for="OpenHour" class="text-danger"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="CloseHour" class="form-label">Giờ đóng cửa</label>
                            <input asp-for="CloseHour" type="time" class="form-control" />
                            <span asp-validation-for="CloseHour" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MapUrl" class="form-label"></label>
                        <input asp-for="MapUrl" class="form-control" placeholder="URL Google Maps" />
                        <span asp-validation-for="MapUrl" class="text-danger"></span>
                        <small class="form-text text-muted">
                            Dán link Google Maps của chi nhánh
                        </small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ImageUrl" class="form-label">Ảnh chi nhánh</label>
                        <!-- ✅ HIỂN THỊ ẢNH HIỆN TẠI -->
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            <div class="mb-2">
                                <label class="form-label text-muted">Ảnh hiện tại:</label>
                                <div>
                                    <img src="@Model.ImageUrl"
                                         alt="@Model.BranchName"
                                         class="img-thumbnail"
                                         style="max-width: 300px; max-height: 200px; object-fit: cover;" />
                                </div>
                            </div>
                        }

                        <!-- Upload ảnh mới -->
                        <input type="file" id="ImageFile" name="ImageFile" class="form-control" accept="image/*" />
                        <small class="form-text text-muted">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <span>Chọn ảnh mới để thay đổi (để trống nếu giữ nguyên ảnh cũ)</span>
                            }
                            else
                            {
                                <span>Chưa có ảnh. Chọn ảnh để tải lên.</span>
                            }
                        </small>
                        <span asp-validation-for="ImageUrl" class="text-danger"></span>

                        <!-- ✅ XEM TRƯỚC ẢNH MỚI -->
                        <div class="mt-2" id="NewImagePreview" style="display:none;">
                            <label class="form-label text-muted">Xem trước ảnh mới:</label>
                            <div>
                                <img id="PreviewImage"
                                     src="#"
                                     alt="Xem trước ảnh mới"
                                     class="img-thumbnail"
                                     style="max-width: 300px; max-height: 200px; object-fit: cover;" />
                            </div>
                        </div>
                    </div>


                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Mô tả</label>
                        <textarea asp-for="Description" class="form-control" rows="4"
                                  placeholder="Mô tả về chi nhánh..."></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Cập nhật
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-times"></i> Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <i class="fas fa-info-circle"></i> Hướng dẫn
            </div>
            <div class="card-body">
                <h6><i class="fas fa-check-circle text-success"></i> Trường bắt buộc:</h6>
                <ul>
                    <li>Tên chi nhánh</li>
                    <li>Thành phố</li>
                    <li>Quận/Huyện</li>
                    <li>Địa chỉ</li>
                </ul>

                <hr>

                <h6><i class="fas fa-lightbulb text-warning"></i> Lưu ý:</h6>
                <ul>
                    <li>Mã chi nhánh sẽ tự động tạo</li>
                    <li>Map URL: Lấy từ Google Maps</li>
                    <li>Giờ mở cửa theo format: HH:mm - HH:mm</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {
            const citySelect = $('#CitySelect');
            const districtSelect = $('#DistrictSelect');

            // ✅ Lấy giá trị từ thuộc tính value của select (đã được Razor render sẵn)
            const currentCity = citySelect.val() || '@Html.Raw(Model.City)';
            const currentDistrict = '@Html.Raw(Model.District)';

            console.log('Current City:', currentCity);
            console.log('Current District:', currentDistrict);

            $.getJSON('@Url.Content("~/data/vietnam_provinces.json")', function (data) {
                // Nạp tất cả tỉnh
                data.forEach(function (province) {
                    const option = $('<option></option>')
                        .val(province.tentinhmoi)
                        .text(province.tentinhmoi)
                        .attr('data-index', province.matinhBNV);
                    citySelect.append(option);
                });

                // ✅ Set giá trị City ngay sau khi load xong
                if (currentCity) {
                    citySelect.val(currentCity);

                    // ✅ Load Districts cho City hiện tại
                    loadDistricts(currentCity, data, currentDistrict);
                }

                // ✅ Xử lý sự kiện change City
                citySelect.on('change', function () {
                    const selectedCity = $(this).val();
                    loadDistricts(selectedCity, data, null);
                });
            }).fail(function() {
                console.error('Không thể load dữ liệu tỉnh/thành phố');
            });

            // ✅ Hàm load Districts riêng biệt
            function loadDistricts(cityName, data, districtToSelect) {
                const province = data.find(p => p.tentinhmoi === cityName);

                districtSelect.empty();
                districtSelect.append('<option value="">-- Chọn Quận/Huyện --</option>');

                if (province && province.phuongxa && province.phuongxa.length > 0) {
                    province.phuongxa.forEach(function (ward) {
                        districtSelect.append(
                            `<option value="${ward.tenphuongxa}">${ward.tenphuongxa}</option>`
                        );
                    });
                    districtSelect.prop('disabled', false);

                    // ✅ Set giá trị District nếu có
                    if (districtToSelect) {
                        districtSelect.val(districtToSelect);
                    }
                } else {
                    districtSelect.prop('disabled', true);
                }
            }
        });
    </script>



    <script>
        // Preview ảnh mới
        const imageFile = document.getElementById('ImageFile');
        const preview = document.getElementById('PreviewImage');
        const previewContainer = document.getElementById('NewImagePreview');
        const removeBtn = document.getElementById('RemoveNewImage');

        imageFile.addEventListener('change', function (event) {
            const file = event.target.files[0];

            if (file) {
                // Kiểm tra dung lượng (5MB)
                if (file.size > 5 * 1024 * 1024) {
                    alert('Kích thước ảnh vượt quá 5MB. Vui lòng chọn ảnh khác.');
                    imageFile.value = '';
                    return;
                }

                // Kiểm tra định dạng
                const validTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/gif'];
                if (!validTypes.includes(file.type)) {
                    alert('Chỉ chấp nhận file ảnh JPG, PNG, GIF.');
                    imageFile.value = '';
                    return;
                }

                // Hiển thị preview
                const reader = new FileReader();
                reader.onload = function(e) {
                    preview.src = e.target.result;
                    previewContainer.style.display = 'block';
                };
                reader.readAsDataURL(file);
            } else {
                preview.src = '#';
                previewContainer.style.display = 'none';
            }
        });

        // Nút hủy ảnh mới
        removeBtn.addEventListener('click', function() {
            imageFile.value = '';
            preview.src = '#';
            previewContainer.style.display = 'none';
        });
    </script>
}