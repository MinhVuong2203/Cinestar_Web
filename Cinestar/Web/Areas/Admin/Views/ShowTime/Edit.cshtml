@model Web.Models.ShowTime
@{
    ViewData["Title"] = "Chỉnh Sửa Suất Chiếu";
}

<link rel="stylesheet" href="~/css/Admin/ShowTime.css" />

<div class="showtime-container">
    <div class="showtime-header">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert" style="margin: 20px 0;">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Lỗi!</strong> @TempData["ErrorMessage"]
            </div>
        }
        <h1><i class="fas fa-edit"></i> Chỉnh Sửa Suất Chiếu</h1>
        <a asp-action="Index" class="showtime-btn-back">
            <i class="fas fa-arrow-left"></i> Quay Lại
        </a>
    </div>

    <div class="showtime-form-container">
        <form asp-action="Edit" method="post" id="showtimeForm">
            <input type="hidden" asp-for="ShowTimeID" />
            <input type="hidden" asp-for="IsDeleted" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="showtime-form-row">
                <div class="showtime-form-group">
                    <label class="showtime-control-label">Mã Suất Chiếu</label>
                    <input asp-for="ShowTimeID" class="showtime-form-control showtime-readonly" disabled />
                </div>

                <div class="showtime-form-group">
                    <label asp-for="MovieID" class="showtime-control-label">Chọn Phim</label>
                    <select asp-for="MovieID" class="showtime-form-control" asp-items="ViewBag.Movies" id="movieSelect">
                        <option value="">-- Chọn Phim --</option>
                    </select>
                    <span asp-validation-for="MovieID" class="text-danger"></span>
                </div>
            </div>

            <div class="showtime-form-row">
                <div class="showtime-form-group">
                    <label class="showtime-control-label">Chọn Chi Nhánh</label>
                    <select class="showtime-form-control" asp-items="ViewBag.Branches" id="branchSelect">
                        <option value="">-- Chọn Chi Nhánh --</option>
                    </select>
                    <small class="showtime-form-text" id="branchHoursInfo" style="display:none; color: #B30C15; font-weight: 600;">
                        <i class="fas fa-clock"></i> Giờ mở cửa: <span id="branchHours"></span>
                    </small>
                </div>

                <div class="showtime-form-group">
                    <label asp-for="RoomID" class="showtime-control-label">Chọn Phòng</label>
                    <select asp-for="RoomID" class="showtime-form-control" id="roomSelect">
                        <option value="@Model.RoomID">@Model.Room.RoomName</option>
                    </select>
                    <span asp-validation-for="RoomID" class="text-danger"></span>
                </div>
            </div>

            <div class="showtime-form-row">
                <div class="showtime-form-group">
                    <label asp-for="StartTime" class="showtime-control-label">Giờ Bắt Đầu</label>
                    <input asp-for="StartTime" class="showtime-form-control" type="datetime-local" id="startTime" step="1" lang="en-GB" />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                    <span class="text-danger" id="startTimeError" style="display:none;"></span>
                </div>

                <div class="showtime-form-group">
                    <label class="showtime-control-label">Giờ Kết Thúc (Dự Kiến)</label>
                    <input type="text" class="showtime-form-control showtime-readonly" id="endTime" readonly />
                    <small class="showtime-form-text">Tự động tính dựa trên thời lượng phim</small>
                    <span class="text-danger" id="endTimeError" style="display:none;"></span>
                </div>
            </div>

            <div class="showtime-form-row">
                <div class="showtime-form-group">
                    <label asp-for="Price" class="showtime-control-label">Giá Vé (VNĐ)</label>
                    <input asp-for="Price" class="showtime-form-control" type="number" step="1000" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>

            <!-- TIMELINE COMPONENT -->
            <div class="timeline-container" id="timelineContainer">
                <div class="timeline-header">
                    <h4><i class="fas fa-clock"></i> Lịch Chiếu Phòng</h4>
                    <span class="timeline-info" id="timelineDate">--</span>
                </div>

                <div class="timeline-wrapper">
                    <div class="timeline-track">
                        <div class="timeline-grid" id="timelineGrid"></div>
                        <div class="timeline-blocks" id="timelineBlocks"></div>
                    </div>
                </div>

                <div class="timeline-legend">
                    <div class="timeline-legend-item">
                        <div class="timeline-legend-box occupied"></div>
                        <span>Đã có suất chiếu</span>
                    </div>
                    <div class="timeline-legend-item">
                        <div class="timeline-legend-box buffer"></div>
                        <span>Khoảng cách tối thiểu (15 phút)</span>
                    </div>
                </div>

                <div class="timeline-conflict-warning" id="conflictWarning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>Cảnh báo: Khung giờ bạn chọn bị trùng hoặc không đủ khoảng cách 15 phút!</span>
                </div>
            </div>

            <div class="showtime-form-actions">
                <button type="submit" class="showtime-btn-submit" id="submitBtn">
                    <i class="fas fa-save"></i> Cập Nhật
                </button>
                <a asp-action="Index" class="showtime-btn-cancel">
                    <i class="fas fa-times"></i> Hủy
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            let movieDuration = @(Model.Movie?.DurationMinutes ?? 0);
            let movieReleaseDate = @Html.Raw(Model.Movie?.StartTime.HasValue == true ? $"new Date('{Model.Movie.StartTime.Value:yyyy-MM-dd}T00:00:00')" : "null");
            let movieEndDate = @Html.Raw(Model.Movie?.EndTime.HasValue == true ? $"new Date('{Model.Movie.EndTime.Value:yyyy-MM-dd}T00:00:00')" : "null");
            let branchOpenHour = '';
            let branchCloseHour = '';
            const currentBranchId = '@Model.Room?.BranchID';
            const currentShowTimeId = '@Model.ShowTimeID';

            // Set chi nhánh hiện tại
            $('#branchSelect').val(currentBranchId);

            // Load giờ mở cửa của chi nhánh hiện tại
            loadBranchHours(currentBranchId);

            // Tính endTime ban đầu
            calculateEndTime();

            // Load timeline ban đầu
            loadTimeline();

            // Validate thời gian ban đầu
            validateStartTime();

            // Force 24-hour format for datetime-local input
            const startTimeInput = document.getElementById('startTime');
            if (startTimeInput) {
                startTimeInput.setAttribute('lang', 'en-GB');

                startTimeInput.addEventListener('focus', function() {
                    this.setAttribute('lang', 'en-GB');
                });
            }

            // Load giờ mở cửa
            function loadBranchHours(branchId) {
                if (branchId) {
                    $.get('@Url.Action("GetBranchHours", "ShowTime")', { branchId: branchId }, function(data) {
                        if (data.success) {
                            branchOpenHour = data.openHour;
                            branchCloseHour = data.closeHour;
                            $('#branchHours').text(branchOpenHour + ' - ' + branchCloseHour);
                            $('#branchHoursInfo').show();

                            // Validate lại sau khi load giờ
                            if ($('#startTime').val()) {
                                validateBranchHours();
                            }
                        }
                    });
                }
            }

            // Load rooms khi chọn chi nhánh
            $('#branchSelect').change(function() {
                const branchId = $(this).val();
                const roomSelect = $('#roomSelect');
                const currentRoomId = '@Model.RoomID';

                if (branchId) {
                    // Load rooms
                    $.get('@Url.Action("GetRoomsByBranch", "ShowTime")', { branchId: branchId }, function(data) {
                        roomSelect.empty();
                        roomSelect.append('<option value="">-- Chọn Phòng --</option>');
                        $.each(data, function(i, room) {
                            const option = $('<option></option>').val(room.value).text(room.text);
                            if (room.value === currentRoomId) {
                                option.attr('selected', 'selected');
                            }
                            roomSelect.append(option);
                        });
                    });

                    // Load giờ mở cửa
                    loadBranchHours(branchId);
                } else {
                    roomSelect.empty();
                    roomSelect.append('<option value="">-- Chọn Chi Nhánh Trước --</option>');
                    $('#branchHoursInfo').hide();
                    branchOpenHour = '';
                    branchCloseHour = '';
                }
            });

            // ✅ UPDATED: Load thời lượng, ngày khởi chiếu và ngày kết thúc phim khi chọn phim
            $('#movieSelect').change(function() {
                const movieId = $(this).val();

                if (movieId) {
                    $.get('@Url.Action("GetMovieDuration", "ShowTime")', { movieId: movieId }, function(data) {
                        movieDuration = data.duration;
                        movieReleaseDate = data.releaseDate ? new Date(data.releaseDate + 'T00:00:00') : null;
                        movieEndDate = data.endDate ? new Date(data.endDate + 'T00:00:00') : null; // ✅ NEW
                        calculateEndTime();
                        validateMovieReleaseDate();
                        validateMovieEndDate(); // ✅ NEW
                        loadTimeline();
                    });
                } else {
                    movieDuration = 0;
                    movieReleaseDate = null;
                    movieEndDate = null; // ✅ NEW
                    $('#endTime').val('');
                }
            });

            // Khi chọn phòng, load timeline
            $('#roomSelect').change(function() {
                loadTimeline();
            });

            // Khi thay đổi giờ bắt đầu
            $('#startTime').on('change input blur', function() {
                validateStartTime();
                validateMovieReleaseDate();
                validateMovieEndDate(); // ✅ NEW
                calculateEndTime();
                validateBranchHours();
                loadTimeline();
                checkConflict();
            });

            function validateStartTime() {
                const startTime = $('#startTime').val();

                if (!startTime) {
                    $('#startTimeError').hide();
                    return true;
                }

                const selectedTime = new Date(startTime);
                const now = new Date();

                // So sánh với thời gian hiện tại
                if (selectedTime <= now) {
                    $('#startTimeError')
                        .text('Giờ bắt đầu phải lớn hơn giờ hiện tại!')
                        .css('display', 'block')
                        .css('color', '#dc3545')
                        .css('font-weight', '500')
                        .css('margin-top', '5px');
                    $('#submitBtn').prop('disabled', true);
                    return false;
                } else {
                    // Chỉ ẩn error của thời gian quá khứ
                    const currentError = $('#startTimeError').text();
                    if (currentError.includes('giờ hiện tại')) {
                        $('#startTimeError').hide();
                    }

                    // Kiểm tra nếu không có lỗi khác thì enable button
                    if ($('#startTimeError:visible').length === 0 &&
                        $('#endTimeError:visible').length === 0 &&
                        !$('#conflictWarning').hasClass('show')) {
                        $('#submitBtn').prop('disabled', false);
                    }
                    return true;
                }
            }

            // ✅ Validation ngày khởi chiếu phim
            function validateMovieReleaseDate() {
                const startTime = $('#startTime').val();

                if (!startTime || !movieReleaseDate) {
                    const currentError = $('#startTimeError').text();
                    if (currentError.includes('ngày khởi chiếu')) {
                        $('#startTimeError').hide();
                    }
                    return true;
                }

                const selectedTime = new Date(startTime);
                const selectedDate = new Date(selectedTime.getFullYear(),
                                              selectedTime.getMonth(),
                                              selectedTime.getDate());
                const releaseDate = new Date(movieReleaseDate.getFullYear(),
                                             movieReleaseDate.getMonth(),
                                             movieReleaseDate.getDate());

                if (selectedDate < releaseDate) {
                    const day = String(movieReleaseDate.getDate()).padStart(2, '0');
                    const month = String(movieReleaseDate.getMonth() + 1).padStart(2, '0');
                    const year = movieReleaseDate.getFullYear();
                    const formattedDate = `${day}/${month}/${year}`;

                    $('#startTimeError')
                        .text(`Giờ bắt đầu phải từ ngày khởi chiếu của phim (${formattedDate}) trở đi!`)
                        .css('display', 'block')
                        .css('color', '#dc3545')
                        .css('font-weight', '500')
                        .css('margin-top', '5px');
                    $('#submitBtn').prop('disabled', true);
                    return false;
                } else {
                    const currentError = $('#startTimeError').text();
                    if (currentError.includes('ngày khởi chiếu')) {
                        $('#startTimeError').hide();
                    }

                    if ($('#startTimeError:visible').length === 0 &&
                        $('#endTimeError:visible').length === 0 &&
                        !$('#conflictWarning').hasClass('show')) {
                        $('#submitBtn').prop('disabled', false);
                    }
                    return true;
                }
            }

            // ✅ NEW: Validation ngày kết thúc chiếu phim
            function validateMovieEndDate() {
                const startTime = $('#startTime').val();

                if (!startTime || !movieEndDate) {
                    const currentError = $('#startTimeError').text();
                    if (currentError.includes('ngày kết thúc')) {
                        $('#startTimeError').hide();
                    }
                    return true;
                }

                const selectedTime = new Date(startTime);
                const selectedDate = new Date(selectedTime.getFullYear(),
                                              selectedTime.getMonth(),
                                              selectedTime.getDate());
                const endDate = new Date(movieEndDate.getFullYear(),
                                        movieEndDate.getMonth(),
                                        movieEndDate.getDate());

                if (selectedDate > endDate) {
                    const day = String(movieEndDate.getDate()).padStart(2, '0');
                    const month = String(movieEndDate.getMonth() + 1).padStart(2, '0');
                    const year = movieEndDate.getFullYear();
                    const formattedDate = `${day}/${month}/${year}`;

                    $('#startTimeError')
                        .text(`Giờ bắt đầu phải trước ngày kết thúc chiếu của phim (${formattedDate})!`)
                        .css('display', 'block')
                        .css('color', '#dc3545')
                        .css('font-weight', '500')
                        .css('margin-top', '5px');
                    $('#submitBtn').prop('disabled', true);
                    return false;
                } else {
                    const currentError = $('#startTimeError').text();
                    if (currentError.includes('ngày kết thúc')) {
                        $('#startTimeError').hide();
                    }

                    if ($('#startTimeError:visible').length === 0 &&
                        $('#endTimeError:visible').length === 0 &&
                        !$('#conflictWarning').hasClass('show')) {
                        $('#submitBtn').prop('disabled', false);
                    }
                    return true;
                }
            }

            function validateBranchHours() {
                const startTime = $('#startTime').val();

                if (!startTime || !branchOpenHour || !branchCloseHour) {
                    return true;
                }

                // Validate thời gian quá khứ trước
                const isValidTime = validateStartTime();
                if (!isValidTime) {
                    return false;
                }

                const start = new Date(startTime);
                const startHour = start.getHours();
                const startMinute = start.getMinutes();

                // Parse giờ mở cửa và thêm 15 phút
                const [openH, openM] = branchOpenHour.split(':').map(Number);
                let minStartMinutes = openH * 60 + openM + 15;
                const minStartHour = Math.floor(minStartMinutes / 60);
                const minStartMinute = minStartMinutes % 60;
                const minStartTimeStr = String(minStartHour).padStart(2, '0') + ':' + String(minStartMinute).padStart(2, '0');

                // Parse giờ đóng cửa
                const [closeH, closeM] = branchCloseHour.split(':').map(Number);

                // Convert to minutes for comparison
                const startMinutes = startHour * 60 + startMinute;
                const closeMinutes = closeH * 60 + closeM;

                let isValid = true;

                // Kiểm tra giờ bắt đầu
                if (startMinutes < minStartMinutes) {
                    isValid = false;
                    const errorMsg = `Giờ bắt đầu phải từ ${minStartTimeStr} trở đi (giờ mở cửa + 15 phút)`;
                    $('#startTimeError')
                        .text(errorMsg)
                        .css('display', 'block')
                        .css('color', '#dc3545')
                        .css('font-weight', '500')
                        .css('margin-top', '5px');
                } else {
                    const currentError = $('#startTimeError').text();
                    if (!currentError.includes('giờ hiện tại') &&
                        !currentError.includes('ngày khởi chiếu') &&
                        !currentError.includes('ngày kết thúc')) {
                        $('#startTimeError').hide();
                    }
                }

                // Kiểm tra giờ kết thúc
                if (movieDuration > 0) {
                    const endMinutes = startMinutes + movieDuration;
                    const endHour = Math.floor(endMinutes / 60);
                    const endMinute = endMinutes % 60;

                    if (endMinutes > closeMinutes) {
                        isValid = false;
                        const endTimeStr = String(endHour).padStart(2, '0') + ':' + String(endMinute).padStart(2, '0');
                        const errorMsg = `Giờ kết thúc (${endTimeStr}) vượt quá giờ đóng cửa (${branchCloseHour})`;
                        $('#endTimeError')
                            .text(errorMsg)
                            .css('display', 'block')
                            .css('color', '#dc3545')
                            .css('font-weight', '500')
                            .css('margin-top', '5px');
                    } else {
                        $('#endTimeError').hide();
                    }
                }

                // Disable/enable submit button
                if (!isValid) {
                    $('#submitBtn').prop('disabled', true);
                } else {
                    if ($('#startTimeError:visible').length === 0 &&
                        $('#endTimeError:visible').length === 0 &&
                        !$('#conflictWarning').hasClass('show')) {
                        $('#submitBtn').prop('disabled', false);
                    }
                }

                return isValid;
            }

            function calculateEndTime() {
                const startTime = $('#startTime').val();

                if (startTime && movieDuration > 0) {
                    const start = new Date(startTime);
                    const end = new Date(start.getTime() + movieDuration * 60000);

                    // Format với AM/PM (SA/CH)
                    const day = String(end.getDate()).padStart(2, '0');
                    const month = String(end.getMonth() + 1).padStart(2, '0');
                    const year = end.getFullYear();
                    let hours = end.getHours();
                    const minutes = String(end.getMinutes()).padStart(2, '0');

                    // Convert to 12-hour format with SA/CH
                    const period = hours >= 12 ? 'CH' : 'SA';
                    if (hours > 12) {
                        hours = hours - 12;
                    } else if (hours === 0) {
                        hours = 12;
                    }
                    hours = String(hours).padStart(2, '0');

                    const formattedEnd = `${day}/${month}/${year} ${hours}:${minutes} ${period}`;

                    $('#endTime').val(formattedEnd);

                    // Validate giờ sau khi tính
                    validateBranchHours();
                } else {
                    $('#endTime').val('');
                }
            }

            function loadTimeline() {
                const roomId = $('#roomSelect').val();
                const startTime = $('#startTime').val();

                if (!roomId || !startTime) {
                    return;
                }

                const currentDate = startTime.split('T')[0];
                $('#timelineDate').text(formatDate(currentDate));

                // Render grid 24h
                renderTimelineGrid();

                // Load showtimes
                $.get('@Url.Action("GetRoomTimeline", "ShowTime")',
                    { roomId: roomId, date: currentDate },
                    function(response) {
                        if (response.success) {
                            renderTimelineBlocks(response.data);
                        }
                    }
                );
            }

            function renderTimelineGrid() {
                const grid = $('#timelineGrid');
                grid.empty();

                for (let hour = 0; hour < 24; hour++) {
                    const hourDiv = $('<div class="timeline-hour"></div>');
                    const label = $('<span class="timeline-hour-label"></span>').text(String(hour).padStart(2, '0') + ':00');
                    hourDiv.append(label);
                    grid.append(hourDiv);
                }
            }

            function renderTimelineBlocks(showtimes) {
                const blocks = $('#timelineBlocks');
                blocks.empty();

                showtimes.forEach(st => {
                    // Skip current showtime being edited
                    if (st.showTimeId === currentShowTimeId) {
                        return;
                    }

                    const start = new Date(st.startDateTime);
                    const end = new Date(st.endDateTime);

                    const leftPercent = (start.getHours() + start.getMinutes() / 60) / 24 * 100;
                    const duration = (end - start) / 1000 / 60;
                    const widthPercent = (duration / 60) / 24 * 100;

                    const block = $('<div class="timeline-block"></div>').css({
                        left: leftPercent + '%',
                        width: widthPercent + '%'
                    });

                    const content = $('<div class="timeline-block-content"></div>');
                    content.append($('<div class="timeline-block-time"></div>').text(st.startTime + ' - ' + st.endTime));
                    content.append($('<div class="timeline-block-title"></div>').text(st.movieTitle));

                    block.append(content);
                    blocks.append(block);

                    // Buffer zones
                    const bufferMinutes = 15;
                    const bufferWidth = (bufferMinutes / 60) / 24 * 100;

                    const bufferBefore = $('<div class="timeline-buffer"></div>').css({
                        left: (leftPercent - bufferWidth) + '%',
                        width: bufferWidth + '%'
                    });
                    blocks.append(bufferBefore);

                    const bufferAfter = $('<div class="timeline-buffer"></div>').css({
                        left: (leftPercent + widthPercent) + '%',
                        width: bufferWidth + '%'
                    });
                    blocks.append(bufferAfter);
                });

                if (showtimes.length === 0 || showtimes.every(st => st.showTimeId === currentShowTimeId)) {
                    blocks.append('<div class="timeline-empty"><i class="fas fa-calendar-check"></i><span>Chưa có suất chiếu nào khác</span></div>');
                }
            }

            function checkConflict() {
                const roomId = $('#roomSelect').val();
                const startTime = $('#startTime').val();

                if (!roomId || !startTime || movieDuration === 0) {
                    $('#conflictWarning').removeClass('show');
                    return;
                }

                // Kiểm tra thời gian quá khứ trước
                if (!validateStartTime()) {
                    return;
                }

                $.post('@Url.Action("CheckTimeConflict", "ShowTime")', {
                    roomId: roomId,
                    startTime: startTime,
                    duration: movieDuration,
                    excludeShowTimeId: currentShowTimeId
                }, function(response) {
                    if (response.hasConflict) {
                        $('#conflictWarning').addClass('show');
                        $('#submitBtn').prop('disabled', true);
                    } else {
                        $('#conflictWarning').removeClass('show');
                        if ($('#startTimeError:visible').length === 0 &&
                            $('#endTimeError:visible').length === 0) {
                            $('#submitBtn').prop('disabled', false);
                        }
                    }
                });
            }

            function formatDate(dateStr) {
                const date = new Date(dateStr);
                const day = date.getDate();
                const month = date.getMonth() + 1;
                const year = date.getFullYear();
                const dayNames = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
                return dayNames[date.getDay()] + ', ' + day + '/' + month + '/' + year;
            }

            // ✅ UPDATED: Validate form khi submit
            $('#showtimeForm').submit(function(e) {
                // Kiểm tra thời gian quá khứ
                if (!validateStartTime()) {
                    e.preventDefault();
                    alert('Giờ bắt đầu phải lớn hơn giờ hiện tại!');
                    return false;
                }

                // Kiểm tra ngày khởi chiếu
                if (!validateMovieReleaseDate()) {
                    e.preventDefault();
                    alert('Giờ bắt đầu phải từ ngày khởi chiếu của phim trở đi!');
                    return false;
                }

                // ✅ NEW: Kiểm tra ngày kết thúc chiếu
                if (!validateMovieEndDate()) {
                    e.preventDefault();
                    alert('Giờ bắt đầu phải trước ngày kết thúc chiếu của phim!');
                    return false;
                }

                // Kiểm tra giờ hoạt động chi nhánh
                if (!validateBranchHours()) {
                    e.preventDefault();
                    alert('Vui lòng kiểm tra lại giờ chiếu phải nằm trong khung giờ hoạt động của chi nhánh!');
                    return false;
                }
            });
        });
    </script>
}