@model Web.Models.ShowTime
@{
    ViewData["Title"] = "Thêm Suất Chiếu";
}
<link rel="stylesheet" href="~/css/Admin/ShowTime.css" />

<div class="showtime-container">
    <div class="form-header">
        <h1><i class="fas fa-clock"></i> Thêm Suất Chiếu</h1>
        <a asp-action="Index" class="btn btn-back"><i class="fas fa-arrow-left"></i> Quay lại</a>
    </div>
    <div class="form-container">
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="st-form-row">
                <div class="form-group">
                    <label asp-for="MovieID">Phim</label>
                    <input asp-for="MovieID" class="form-control" />
                    <span asp-validation-for="MovieID" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="RoomID">Phòng</label>
                    <input asp-for="RoomID" class="form-control" />
                    <span asp-validation-for="RoomID" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="StartTime">Giờ bắt đầu</label>
                    <input asp-for="StartTime" type="datetime-local" class="form-control" />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Price">Giá vé</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn btn-submit"><i class="fas fa-save"></i> Lưu</button>
                <a asp-action="Index" class="btn btn-cancel"><i class="fas fa-times"></i> Hủy</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
