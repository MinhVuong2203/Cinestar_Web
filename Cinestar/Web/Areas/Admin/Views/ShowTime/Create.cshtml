@model Web.Models.ShowTime
@{
    ViewData["Title"] = "Thêm Suất Chiếu";
}

<link rel="stylesheet" href="~/css/Admin/ShowTime.css" />

<div class="showtime-container">
    <div class="showtime-header">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert" style="margin: 20px 0;">
                <i class="fas fa-exclamation-triangle"></i>
                <strong>Lỗi!</strong> @TempData["ErrorMessage"]
            </div>
        }
        <h1><i class="fas fa-plus-circle"></i> Thêm Suất Chiếu Mới</h1>
        <a asp-action="Index" class="showtime-btn-back">
            <i class="fas fa-arrow-left"></i> Quay Lại
        </a>
    </div>

    <div class="showtime-form-container">
        <form asp-action="Create" method="post" id="showtimeForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="showtime-form-row">
                <div class="showtime-form-group">
                    <label asp-for="MovieID" class="showtime-control-label">Chọn Phim</label>
                    <select asp-for="MovieID" class="showtime-form-control" asp-items="ViewBag.Movies" id="movieSelect">
                        <option value="">-- Chọn Phim --</option>
                    </select>
                    <span asp-validation-for="MovieID" class="text-danger"></span>
                </div>

                <div class="showtime-form-group">
                    <label class="showtime-control-label">Chọn Chi Nhánh</label>
                    <select class="showtime-form-control" asp-items="ViewBag.Branches" id="branchSelect">
                        <option value="">-- Chọn Chi Nhánh --</option>
                    </select>
                </div>
            </div>

            <div class="showtime-form-row">
                <div class="showtime-form-group">
                    <label asp-for="RoomID" class="showtime-control-label">Chọn Phòng</label>
                    <select asp-for="RoomID" class="showtime-form-control" id="roomSelect" disabled>
                        <option value="">-- Chọn Chi Nhánh Trước --</option>
                    </select>
                    <span asp-validation-for="RoomID" class="text-danger"></span>
                </div>

                <div class="showtime-form-group">
                    <label asp-for="Price" class="showtime-control-label">Giá Vé (VNĐ)</label>
                    <input asp-for="Price" class="showtime-form-control" type="number" step="1000" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
            </div>

            <div class="showtime-form-row">
                <div class="showtime-form-group">
                    <label asp-for="StartTime" class="showtime-control-label">Giờ Bắt Đầu</label>
                    <input asp-for="StartTime" class="showtime-form-control" type="datetime-local" id="startTime" />
                    <span asp-validation-for="StartTime" class="text-danger"></span>
                </div>

                <div class="showtime-form-group">
                    <label class="showtime-control-label">Giờ Kết Thúc (Dự Kiến)</label>
                    <input type="text" class="showtime-form-control showtime-readonly" id="endTime" readonly />
                    <small class="showtime-form-text">Tự động tính dựa trên thời lượng phim</small>
                </div>
            </div>

            <!-- TIMELINE COMPONENT -->
            <div class="timeline-container" id="timelineContainer" style="display: none;">
                <div class="timeline-header">
                    <h4><i class="fas fa-clock"></i> Lịch Chiếu Phòng</h4>
                    <span class="timeline-info" id="timelineDate">--</span>
                </div>

                <div class="timeline-wrapper">
                    <div class="timeline-track">
                        <!-- Grid 24 giờ -->
                        <div class="timeline-grid" id="timelineGrid">
                            <!-- JavaScript sẽ render grid -->
                        </div>

                        <!-- Các block suất chiếu -->
                        <div class="timeline-blocks" id="timelineBlocks">
                            <!-- JavaScript sẽ render blocks -->
                        </div>
                    </div>
                </div>

                <div class="timeline-legend">
                    <div class="timeline-legend-item">
                        <div class="timeline-legend-box occupied"></div>
                        <span>Đã có suất chiếu</span>
                    </div>
                    <div class="timeline-legend-item">
                        <div class="timeline-legend-box buffer"></div>
                        <span>Khoảng cách tối thiểu (15 phút)</span>
                    </div>
                </div>

                <!-- Conflict warning -->
                <div class="timeline-conflict-warning" id="conflictWarning">
                    <i class="fas fa-exclamation-triangle"></i>
                    <span>Cảnh báo: Khung giờ bạn chọn bị trùng hoặc không đủ khoảng cách 15 phút!</span>
                </div>
            </div>

            <div class="showtime-form-actions">
                <button type="submit" class="showtime-btn-submit" id="submitBtn">
                    <i class="fas fa-save"></i> Lưu Suất Chiếu
                </button>
                <a asp-action="Index" class="showtime-btn-cancel">
                    <i class="fas fa-times"></i> Hủy
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
            let movieDuration = 0;
            let currentRoomId = '';
            let currentDate = '';

            // Load rooms khi chọn chi nhánh
            $('#branchSelect').change(function() {
                const branchId = $(this).val();
                const roomSelect = $('#roomSelect');

                if (branchId) {
                    $.get('@Url.Action("GetRoomsByBranch", "ShowTime")', { branchId: branchId }, function(data) {
                        roomSelect.empty();
                        roomSelect.append('<option value="">-- Chọn Phòng --</option>');
                        $.each(data, function(i, room) {
                            roomSelect.append($('<option></option>').val(room.value).text(room.text));
                        });
                        roomSelect.prop('disabled', false);
                    });
                } else {
                    roomSelect.empty();
                    roomSelect.append('<option value="">-- Chọn Chi Nhánh Trước --</option>');
                    roomSelect.prop('disabled', true);
                    hideTimeline();
                }
            });

            // Load thời lượng phim khi chọn phim
            $('#movieSelect').change(function() {
                const movieId = $(this).val();

                if (movieId) {
                    $.get('@Url.Action("GetMovieDuration", "ShowTime")', { movieId: movieId }, function(data) {
                        movieDuration = data.duration;
                        calculateEndTime();
                        loadTimeline();
                    });
                } else {
                    movieDuration = 0;
                    $('#endTime').val('');
                }
            });

            // Khi chọn phòng, load timeline
            $('#roomSelect').change(function() {
                currentRoomId = $(this).val();
                loadTimeline();
            });

            // Khi thay đổi giờ bắt đầu
            $('#startTime').change(function() {
                calculateEndTime();
                loadTimeline();
                checkConflict();
            });

            function calculateEndTime() {
                const startTime = $('#startTime').val();

                if (startTime && movieDuration > 0) {
                    const start = new Date(startTime);
                    const end = new Date(start.getTime() + movieDuration * 60000);

                    const day = String(end.getDate()).padStart(2, '0');
                    const month = String(end.getMonth() + 1).padStart(2, '0');
                    const year = end.getFullYear();
                    let hours = end.getHours();
                    const minutes = String(end.getMinutes()).padStart(2, '0');
                    const period = hours >= 12 ? 'CH' : 'SA';

                    hours = hours % 12;
                    hours = hours ? hours : 12;
                    hours = String(hours).padStart(2, '0');

                    const formattedEnd = `${day}/${month}/${year} ${hours}:${minutes} ${period}`;

                    $('#endTime').val(formattedEnd);
                } else {
                    $('#endTime').val('');
                }
            }

            function loadTimeline() {
                const roomId = $('#roomSelect').val();
                const startTime = $('#startTime').val();

                if (!roomId || !startTime) {
                    hideTimeline();
                    return;
                }

                currentRoomId = roomId;
                currentDate = startTime.split('T')[0];

                // Hiển thị timeline container
                $('#timelineContainer').show();
                $('#timelineDate').text(formatDate(currentDate));

                // Render grid 24h
                renderTimelineGrid();

                // Load showtimes
                $.get('@Url.Action("GetRoomTimeline", "ShowTime")',
                    { roomId: roomId, date: currentDate },
                    function(response) {
                        if (response.success) {
                            renderTimelineBlocks(response.data);
                        }
                    }
                );
            }

            function renderTimelineGrid() {
                const grid = $('#timelineGrid');
                grid.empty();

                for (let hour = 0; hour < 24; hour++) {
                    const hourDiv = $('<div class="timeline-hour"></div>');
                    const label = $('<span class="timeline-hour-label"></span>').text(hour + ':00');
                    hourDiv.append(label);
                    grid.append(hourDiv);
                }
            }

            function renderTimelineBlocks(showtimes) {
                const blocks = $('#timelineBlocks');
                blocks.empty();

                showtimes.forEach(st => {
                    const start = new Date(st.startDateTime);
                    const end = new Date(st.endDateTime);

                    // Tính vị trí và width
                    const leftPercent = (start.getHours() + start.getMinutes() / 60) / 24 * 100;
                    const duration = (end - start) / 1000 / 60; // minutes
                    const widthPercent = (duration / 60) / 24 * 100;

                    // Tạo block
                    const block = $('<div class="timeline-block"></div>').css({
                        left: leftPercent + '%',
                        width: widthPercent + '%'
                    });

                    const content = $('<div class="timeline-block-content"></div>');
                    content.append($('<div class="timeline-block-time"></div>').text(st.startTime + ' - ' + st.endTime));
                    content.append($('<div class="timeline-block-title"></div>').text(st.movieTitle));

                    block.append(content);
                    blocks.append(block);

                    // Thêm buffer zones (15 phút trước và sau)
                    const bufferMinutes = 15;
                    const bufferWidth = (bufferMinutes / 60) / 24 * 100;

                    // Buffer trước
                    const bufferBefore = $('<div class="timeline-buffer"></div>').css({
                        left: (leftPercent - bufferWidth) + '%',
                        width: bufferWidth + '%'
                    });
                    blocks.append(bufferBefore);

                    // Buffer sau
                    const bufferAfter = $('<div class="timeline-buffer"></div>').css({
                        left: (leftPercent + widthPercent) + '%',
                        width: bufferWidth + '%'
                    });
                    blocks.append(bufferAfter);
                });

                // Nếu không có suất chiếu
                if (showtimes.length === 0) {
                    blocks.append('<div class="timeline-empty"><i class="fas fa-calendar-check"></i><span>Chưa có suất chiếu nào</span></div>');
                }
            }

            function checkConflict() {
                const roomId = $('#roomSelect').val();
                const startTime = $('#startTime').val();

                if (!roomId || !startTime || movieDuration === 0) {
                    return;
                }

                $.post('@Url.Action("CheckTimeConflict", "ShowTime")', {
                    roomId: roomId,
                    startTime: startTime,
                    duration: movieDuration
                }, function(response) {
                    if (response.hasConflict) {
                        $('#conflictWarning').addClass('show');
                        $('#submitBtn').prop('disabled', true);
                    } else {
                        $('#conflictWarning').removeClass('show');
                        $('#submitBtn').prop('disabled', false);
                    }
                });
            }

            function hideTimeline() {
                $('#timelineContainer').hide();
                $('#conflictWarning').removeClass('show');
            }

            function formatDate(dateStr) {
                const date = new Date(dateStr);
                const day = date.getDate();
                const month = date.getMonth() + 1;
                const year = date.getFullYear();
                const dayNames = ['Chủ Nhật', 'Thứ Hai', 'Thứ Ba', 'Thứ Tư', 'Thứ Năm', 'Thứ Sáu', 'Thứ Bảy'];
                return dayNames[date.getDay()] + ', ' + day + '/' + month + '/' + year;
            }
        });
    </script>
}