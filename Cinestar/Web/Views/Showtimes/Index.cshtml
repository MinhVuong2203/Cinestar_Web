@section styles {
    <link href="~/css/showtimes.css" rel="stylesheet" />
}

<div class="container text_color ">
    <div class="row border-top border-light pt-3">
        <!-- Phần hình ảnh - 4 cột -->
        <div class="col-lg-4 col-md-12 mb-4">
            <img src="~/image/cuc-vang-cua-ngoai-poster.webp"
                 alt="Cục Vàng Của Ngoại"
                 class="movie-poster">
            <div class="movie-info mt-3">
                <div class="movie-title">CỤC VÀNG CỦA NGOẠI (T13)</div>
                <div class="info-item">
                    <i class="fas fa-users"></i>
                    <span>Gia đình, Tâm Lý</span>
                </div>
                <div class="info-item">
                    <i class="fas fa-clock"></i>
                    <span>119 phút</span>
                </div>
                <div class="info-item">
                    <i class="fas fa-globe"></i>
                    <span>Việt Nam</span>
                </div>
                <div class="info-item">
                    <i class="fas fa-language"></i>
                    <span>Tiếng Việt (VN)</span>
                </div>
            </div>
        </div>

        <!-- Phần thông tin - 8 cột -->
        <div class="col-lg-8 col-md-12">
            <div class="cinema-section">
                <div class="row">
                
                    <div class="col-lg-4 col-md-12">
                    
                        <div class="cinema-name">Cinestar Dà Lạt (Lâm Đồng)</div>
                        <div class="cinema-address">Quảng Trường Lâm Viên, Phường Xuân Hương - Dà Lạt, tỉnh Lâm Đồng</div>    
                    </div>
                    <div class="col-lg-8 col-md-12">
                        <div class="ticket-type">STANDARD</div>
                        <div class="time-slots">
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "11:10", type = "standard" })" class="time-slot">11:10</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "12:00", type = "standard" })" class="time-slot">12:00</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "13:30", type = "standard" })" class="time-slot">13:30</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "14:20", type = "standard" })" class="time-slot">14:20</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "15:05", type = "standard" })" class="time-slot">15:05</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "15:50", type = "standard" })" class="time-slot">15:50</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "16:40", type = "standard" })" class="time-slot">16:40</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "17:25", type = "standard" })" class="time-slot">17:25</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "18:10", type = "standard" })" class="time-slot">18:10</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "19:00", type = "standard" })" class="time-slot">19:00</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "19:45", type = "standard" })" class="time-slot">19:45</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "20:30", type = "standard" })" class="time-slot">20:30</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "21:20", type = "standard" })" class="time-slot">21:20</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "22:05", type = "standard" })" class="time-slot">22:05</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "22:50", type = "standard" })" class="time-slot">22:50</a>
                            <a href="@Url.Action("BookTicket", "Booking", new { cinema = "dalat", time = "23:40", type = "standard" })" class="time-slot">23:40</a>
                        </div>    
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Không cần JavaScript nữa vì đã dùng thẻ <a>
    // Nếu muốn giữ hiệu ứng highlight khi click, có thể thêm:
    document.querySelectorAll('.time-slot').forEach(slot => {
        slot.addEventListener('click', function(e) {
            // Bỏ chọn tất cả các slot khác
            document.querySelectorAll('.time-slot').forEach(s => {
                s.classList.remove('selected');
            });
            // Thêm class selected cho slot hiện tại
            this.classList.add('selected');
        });
    });
</script>