@using Net.payOS.Types
@{
    ViewData["Title"] = "Thanh toán thành công";
}

@section Styles {
	<link rel="stylesheet" href="~/css/payment/PaymentSuccess.css?v=@DateTime.Now.Ticks" />
}

<div class="payment-result-container">
    <div class="success-icon">✓</div>
    <h1 class="success-title">Thanh toán thành công!</h1>
    <p class="success-message">Cảm ơn bạn đã thanh toán. Đơn hàng của bạn đã được xác nhận.</p>

    @if (ViewBag.PaymentInfo != null)
    {
        var paymentInfo = ViewBag.PaymentInfo as PaymentLinkInformation;
        <div class="payment-details">
            <div class="detail-row">
                <span class="detail-label">Mã đơn hàng:</span>
                <span class="detail-value">@paymentInfo?.id</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Số tiền:</span>
                <span class="detail-value">@String.Format("{0:N0} VND", paymentInfo?.amount ?? 0)</span>
            </div>
            <div class="detail-row">
                <span class="detail-label">Trạng thái:</span>
                <span class="detail-value" style="color: #28a745; font-weight: bold;">
                    @(paymentInfo?.status?.ToUpper() == "PAID" ? "Đã thanh toán" : paymentInfo?.status)
                </span>
            </div>
            @if (paymentInfo?.createdAt != null)
            {
                <div class="detail-row">
                    <span class="detail-label">Thời gian:</span>
                    <span class="detail-value">@paymentInfo.createdAt</span>
                </div>
            }
        </div>
    }

    <div class="btn-group">
        <a asp-controller="Home" asp-action="Index" asp-area="" class="btn-primary">Về trang chủ</a>
        <a href="#" onclick="window.print(); return false;" class="btn-secondary">In hóa đơn</a>
    </div>
</div>

@section Scripts {
    <script>
        // Clear localStorage after successful payment
        localStorage.removeItem('customerInfo');
        localStorage.removeItem('bookingInfo');
        localStorage.removeItem('currentOrderCode');
    </script>
}
