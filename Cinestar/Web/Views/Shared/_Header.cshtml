<header class="site-header">
    <div class="container">

    <div class="header-main">
        <div class="container-fluid">
            <div class="header-wrapper">
                <!-- Logo -->
                <a asp-controller="Home" asp-action="Index" class="brand-logo">
                    <img src="~/image/header-logo.webp" alt="Cinestar" />
                </a>

                <!-- CTA Buttons -->
                <div class="cta-buttons">
                    <a asp-controller="Booking" asp-action="Index" class="btn-cta btn-yellow btn-hover-purple btn-text-light btn-text-hover-light">
                            <i class="fa-solid fa-ticket" style="color: #ffffff;"></i>
                        <span>ĐẶT VÉ NGAY</span>
                    </a>
                    <a asp-controller="Booking" asp-action="Combo" class="btn-cta btn-purple btn-hover-orange btn-text-light">
                            <i class="fa-solid fa-glass-water"></i>
                        <span>ĐẶT BẮP NƯỚC</span>
                    </a>
                </div>

                <!-- Search Bar -->
                <div class="header-search">
                    <form asp-controller="Movie" asp-action="Search" method="get">
                        <input type="text" name="keyword" placeholder="Tìm phim, rạp" class="search-input" />
                        <button type="submit" class="search-btn">
                                <i class="fa-brands fa-searchengin" style="color: darkgray"></i>
                        </button>
                    </form>
                </div>

                <!-- User Section -->
                <div class="header-user">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Profile" class="user-profile">
                                <i class="fa-solid fa-user"></i>
                            <span>@User.Identity.Name</span>
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="user-profile">
                                <i class="fa-solid fa-user"></i>
                            <span>NGUYÊN...</span>
                        </a>
                    }

                </div>
                    <div class="language-selector">
                        <img class="flag-icon" src="~/image/VN.jpeg" alt="VN" class="flag-icon" />
                        <span>VN</span>
                        <i class="icon-chevron-down"></i>
                    </div>
            </div>
        </div>
    </div>

    <!-- Bottom Navigation -->
    <nav class="header-nav">
        <div class="container-fluid">
            <div class="nav-wrapper">
                <!-- Left Navigation -->
                <div class="nav-left">
                    <a asp-controller="Cinema" asp-action="Select" class="nav-link">
                            <i class="fa-solid fa-location-dot"></i>
                        <span>Chọn rạp</span>
                    </a>
                    <a asp-controller="Showtime" asp-action="Index" class="nav-link">
                            <i class="fa-solid fa-location-dot"></i>
                        <span>Lịch chiếu</span>
                    </a>
                </div>

                <!-- Right Navigation -->
                <div class="nav-right">
                    <a asp-controller="Promotion" asp-action="Index" class="nav-link">Khuyến mãi</a>
                    <a asp-controller="Event" asp-action="Index" class="nav-link">Tổ chức sự kiện</a>
                    <a asp-controller="Service" asp-action="Index" class="nav-link">Dịch vụ giải trí khác</a>
                    <a asp-controller="About" asp-action="Index" class="nav-link">Giới thiệu</a>
                </div>
            </div>
        </div>
    </nav>

    </div>
    <!-- Main Header -->
</header>