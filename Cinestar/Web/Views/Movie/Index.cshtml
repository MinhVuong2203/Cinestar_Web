@section styles {
    <link href="~/css/movie.css" rel="stylesheet" />
    <link href="~/css/bookTicket.css" rel="stylesheet" />
    <link href="~/lib/fontawesome-free-7.1.0-web/css/all.min.css" rel="stylesheet" />
}
<div class="container">
    @* thông tin phim*@
    <div class="movie-detail-container">
        <div class="movie-content">
            <!-- Poster Section -->
            <div class="movie-poster">
                <div class="type-badge">2D</div>
                <div class="age-rating">T13</div>
                <img src="~/image/cuc-vang-cua-ngoai-poster.webp" alt="Cục Vàng Của Ngoại">
            </div>

            <!-- Info Section -->
            <div class="movie-info">
                <h1 class="movie-title">CỤC VÀNG CỦA NGOẠI (T13)</h1>

                <div class="movie-meta">
                    <div class="meta-item">
                        <i class="fas fa-home"></i>
                        <span>Gia đình, Tâm Lý</span>
                    </div>
                    <div class="meta-item">
                        <i class="far fa-clock"></i>
                        <span>119'</span>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-flag"></i>
                        <span>Việt Nam</span>
                    </div>
                    <div class="meta-item">
                        <i class="fas fa-closed-captioning"></i>
                        <span>VN</span>
                    </div>
                    <div class="meta-item age-restriction">
                        <i class="fas fa-user-friends"></i>
                        <span>T13: Phim dành cho khán giả từ đủ 13 tuổi trở lên (13+)</span>
                    </div>
                </div>

                <div class="movie-section">
                    <h2 class="section-title">MÔ TẢ</h2>
                    <div class="description-grid">
                        <div class="desc-item">
                            <strong>Đạo diễn:</strong> Khương Ngọc
                        </div>
                        <div class="desc-item">
                            <strong>Diễn viên:</strong> Việt Hương, Hồng Đào, Lê Khánh, Bằng Di, Lâm Thanh Mỹ, Hữu Châu, Tuấn Khải, Thu Đan, Panda
                        </div>
                        <div class="desc-item">
                            <strong>Khởi chiếu:</strong> Thứ Sáu, 17/10/2025
                        </div>
                    </div>
                </div>

                <div class="movie-section">
                    <h2 class="section-title">NỘI DUNG PHIM</h2>
                    <div class="movie-synopsis">
                        <p class="synopsis-text">
                            Lấy cảm hứng từ những ký ức tuổi thơ ngoài ngọa, "Cục Vàng Của Ngoại" mang đến câu chuyện ấm áp về tình bà cháu trong một xóm nhỏ chân chùa nghĩa tình. Bà Hậu - người phụ nữ cả đời tần tảo, nay trở thành chỗ dựa duy nhất của cháu ngoại khi con gái bỏ đi. Dẫu cuộc sống còn nhiều nhọc nhằn, tình thương bà dành cho cháu vẫn luôn tròn ven. Với bà, cháu là "cục vàng" - niềm vui, niềm an ủi và cũng là lẽ sống của đời mình. Bộ phim như những dấn khán giả trở lại những khoảnh khắc<span class="ellipsis">...</span>
                            <span class="synopsis-more hidden">quen thuộc nơi xóm nhỏ: nụ cười hồn nhiên của cháu, vòng tay chở che của bà và sự đùm bọc từ hàng xóm láng giềng. Tất cả cùng hòa thành một bức tranh đời thường ấm áp, gợi nhắc về tuổi thơ bình yên và tình người mộc mạc, chân thành</span> <span class="read-more">Xem thêm</span>
                        </p>
                    </div>
                </div>

                <a href="#" class="btn-cta btn-yellow btn-hover-purple btn-text-dark btn-text-hover-light btn-lg">
                    <i class="fas fa-play-circle"></i>
                    <span>Xem Trailer</span>
                </a>
            </div>
        </div>
    </div>
    @* đặt vé *@
    <div class="shtime-wr">
        <div class="shtime-heading">
            <h2 class="heading">LỊCH CHIẾU</h2>
            <div class="selected-time">
                <div class="box-time">
                    <p class="date">
                        30/10
                    </p>
                    <p class="day">
                        Thứ Năm
                    </p>
                </div>
            </div>
        </div>

        <div class="shtime-body">
            <h2 class="heading">DANH SÁCH RẠP</h2>
            <div class="select-location">
                <div class="location-selected">
                    <i class="fas fa-location-dot" style="color: #ffffff;"></i>
                    <span class="location-name">TIỀN GIANG</span>
                    <span class="dropdown-arrow">&#9662;</span>
                </div>
                <div class="location-dropdown">
                    <div class="location-option">Hồ Chí Minh</div>
                    <div class="location-option">Đà Lạt</div>
                    <div class="location-option">Bình Dương</div>
                    <div class="location-option">Huế</div>
                    <div class="location-option active">Tiền Giang</div>
                    <div class="location-option">Kiên Giang</div>
                    <div class="location-option">Lâm Đồng</div>
                </div>
            </div>
        </div>

        <div class="shtime-fr">
            <ul class="cinestar-list">
                <li class="cinestar-item open">
                    <div class="cinestar-heading">
                        <h4 class="title">Cinestar Mỹ Tho (Tiền Giang)</h4>
                        <span class="chevron">
                            <i class="fa-solid fa-chevron-down" style="color: #ffffff;"></i>
                        </span>
                    </div>
                    <div class="cinestar-body">
                        <p class="address">Số 52 Đinh Bộ Lĩnh, Phường Mỹ Tho, Tỉnh Đồng Tháp</p>
                        <ul class="list-infor">
                            <li class="item-infor">
                                <div class="tt">Standard</div>
                                <ul class="list-time">
                                    <li class="item-time">11:00</li>
                                    <li class="item-time active">12:00</li>
                                    <li class="item-time">13:20</li>
                                    <li class="item-time">14:20</li>
                                    <li class="item-time">15:40</li>
                                    <li class="item-time">16:40</li>
                                    <li class="item-time">18:00</li>
                                    <li class="item-time">19:20</li>
                                    <li class="item-time">21:20</li>
                                </ul>
                            </li>
                        </ul>
                    </div>
                </li>
            </ul>
        </div>

        <div class="ticket-wr">
            <h2 class="heading">CHỌN LOẠI VÉ</h2>
            <div class="ticket-container">
                <div class="content">
                    <div class="content-top">
                        <p class="name">NGƯỜI LỚN</p>
                        <div class="desc">
                            <p>NẰM</p>
                        </div>
                        <div class="price">
                            <p>99,000 VNĐ</p>
                        </div>
                    </div>

                    <div class="content-bottom">
                        <div class="count">
                            <div class="count-btn">
                                <button class="decrease">-</button>
                                <span class="quantity">0</span>
                                <button class="increase">+</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script src="~/js/bookTicket.js"></script>
    </div>
    @* end *@

