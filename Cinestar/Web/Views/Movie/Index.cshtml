@section styles {
    <link href="~/css/movie.css" rel="stylesheet" />
    <link href="~/css/Customer/bookTicket.css" rel="stylesheet" />
    <link href="~/lib/fontawesome-free-7.1.0-web/css/all.min.css" rel="stylesheet" />
    <link href="~/css/Customer/homeCustomer.css" rel="stylesheet" />
}

@{
    var nowShowingMovies = ViewData["NowShowing"] as List<Movie>;
    var comingSoonMovies = ViewData["ComingSoon"] as List<Movie>;
}

<div class="container">
    <section class="section-2">
        <div class="container-movie">
            <h2 class="movie-section-title">PHIM ĐANG CHIẾU</h2>
            <div class="movie-carousel-wrapper">
                <button class="carousel-control-prev" type="button" id="prevBtn">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>

                <div class="carousel-viewport">
                    <div class="carousel-track" id="movieCarousel">
                        @if (nowShowingMovies != null && nowShowingMovies.Any())
                        {
                            int slideCount = (int)Math.Ceiling(nowShowingMovies.Count / 4.0);
                            for (int slideIndex = 0; slideIndex < slideCount; slideIndex++)
                            {
                                var moviesInSlide = nowShowingMovies.Skip(slideIndex * 4).Take(4).ToList();
                                <div class="carousel-slide">
                                    <div class="row g-4 justify-content-between">
                                        @foreach (var movie in moviesInSlide)
                                        {
                                            <div class="col-lg-3 col-md-6 col-sm-6 movie-card-col">
                                                <div class="movie-card">
                                                    <div class="movie-poster">
                                                        <img src="@(string.IsNullOrEmpty(movie.ImageUrl) ? "~/image/movie/default-poster.webp" : movie.ImageUrl)"
                                                             alt="@movie.Title">
                                                        <div class="badge-container">
                                                            <div class="movie-type-badge">2D</div>
                                                            <div class="age-badge">@(string.IsNullOrEmpty(movie.AgeLimit) ? "P" : movie.AgeLimit)</div>
                                                        </div>
                                                        <div class="movie-info-overlay">
                                                            <h3 class="overlay-title">@movie.Title.ToUpper()</h3>
                                                            <div class="movie-info-item">
                                                                <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" /></svg>
                                                                <span>@(string.IsNullOrEmpty(movie.Genre) ? "Đang cập nhật" : movie.Genre)</span>
                                                            </div>
                                                            <div class="movie-info-item">
                                                                <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" /></svg>
                                                                <span>@(movie.DurationMinutes.HasValue? movie.DurationMinutes + "'" : "N/A")</span>
                                                            </div>
                                                            <div class="movie-info-item">
                                                                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" /></svg>
                                                                <span>@(string.IsNullOrEmpty(movie.Language) ? "Đang cập nhật" : movie.Language)</span>
                                                            </div>
                                                            <div class="movie-info-item">
                                                                <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4V8l8 5 8-5v10zm-8-7L4 6h16l-8 5z" /></svg>
                                                                <span>@(string.IsNullOrEmpty(movie.Sub) ? "Đang cập nhật" : movie.Sub)</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <h3 class="movie-title">@movie.Title.ToUpper()</h3>
                                                    <div class="movie-actions">
                                                        @if (!string.IsNullOrEmpty(movie.LinkTrailer))
                                                        {
                                                            <a href="@movie.LinkTrailer" target="_blank" class="btn-trailer">
                                                                <span class="play-icon">▶</span> Xem Trailer
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a href="#" class="btn-trailer" style="opacity: 0.5; cursor: not-allowed;">
                                                                <span class="play-icon">▶</span> Xem Trailer
                                                            </a>
                                                        }
                                                        <a href="/movie/details/@movie.MovieID" class="btn-book">ĐẶT VÉ</a>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="carousel-slide">
                                <div class="row g-4 justify-content-center">
                                    <div class="col-12 text-center">
                                        <p class="text-muted">Hiện tại chưa có phim đang chiếu.</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <button class="carousel-control-next" type="button" id="nextBtn">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            </div>

            <div class="carousel-dots" id="carouselDots"></div>

            @if (nowShowingMovies != null && nowShowingMovies.Count > 0)
            {
                <a href="@Url.Action("showing", "Movie", new { area = " " })" , class="btn-view-more">XEM THÊM</a>
            }
            else
            {
                <button class="btn-view-more" disabled style="opacity: 0.5; cursor: not-allowed;">XEM THÊM</button>
            }
        </div>
    </section>

    <!-- Section PHIM SẮP CHIẾU -->
    <section class="section-3">
        <div class="container-movie">
            <h2 class="movie-section-title">PHIM SẮP CHIẾU</h2>
            <div class="movie-carousel-wrapper">
                <button class="carousel-control-prev" type="button" id="prevBtn3">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                </button>

                <div class="carousel-viewport">
                    <div class="carousel-track" id="movieCarousel3">
                        @if (comingSoonMovies != null && comingSoonMovies.Any())
                        {
                            int slideCount = (int)Math.Ceiling(comingSoonMovies.Count / 4.0);
                            for (int slideIndex = 0; slideIndex < slideCount; slideIndex++)
                            {
                                var moviesInSlide = comingSoonMovies.Skip(slideIndex * 4).Take(4).ToList();
                                <div class="carousel-slide">
                                    <div class="row g-4 justify-content-between">
                                        @foreach (var movie in moviesInSlide)
                                        {
                                            <div class="col-lg-3 col-md-6 col-sm-6 movie-card-col">
                                                <div class="movie-card">
                                                    <div class="movie-poster">
                                                        <img src="@(string.IsNullOrEmpty(movie.ImageUrl) ? "~/image/movie/default-poster.webp" : movie.ImageUrl)"
                                                             alt="@movie.Title">
                                                        <div class="badge-container">
                                                            <div class="movie-type-badge">2D</div>
                                                            <div class="age-badge">@(string.IsNullOrEmpty(movie.AgeLimit) ? "P" : movie.AgeLimit)</div>
                                                        </div>
                                                        <div class="movie-info-overlay">
                                                            <h3 class="overlay-title">@movie.Title.ToUpper()</h3>
                                                            <div class="movie-info-item">
                                                                <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" /></svg>
                                                                <span>@(string.IsNullOrEmpty(movie.Genre) ? "Đang cập nhật" : movie.Genre)</span>
                                                            </div>
                                                            <div class="movie-info-item">
                                                                <svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z" /></svg>
                                                                <span>@(movie.DurationMinutes.HasValue? movie.DurationMinutes + "'" : "N/A")</span>
                                                            </div>
                                                            <div class="movie-info-item">
                                                                <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" /></svg>
                                                                <span>@(string.IsNullOrEmpty(movie.Language) ? "Đang cập nhật" : movie.Language)</span>
                                                            </div>
                                                            <div class="movie-info-item">
                                                                <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4V8l8 5 8-5v10zm-8-7L4 6h16l-8 5z" /></svg>
                                                                <span>@(string.IsNullOrEmpty(movie.Sub) ? "Đang cập nhật" : movie.Sub)</span>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    @if (movie.StartTime.HasValue)
                                                    {
                                                        <h4 class="movie-date">Khởi Chiếu @movie.StartTime.Value.ToString("dd/MM/yyyy")</h4>
                                                    }
                                                    <h3 class="movie-title">@movie.Title.ToUpper()</h3>
                                                    <div class="movie-actions">
                                                        @if (!string.IsNullOrEmpty(movie.LinkTrailer))
                                                        {
                                                            <a href="@movie.LinkTrailer" target="_blank" class="btn-trailer">
                                                                <span class="play-icon">▶</span> Xem Trailer
                                                            </a>
                                                        }
                                                        else
                                                        {
                                                            <a href="#" class="btn-trailer" style="opacity: 0.5; cursor: not-allowed;">
                                                                <span class="play-icon">▶</span> Xem Trailer
                                                            </a>
                                                        }
                                                        <a href="@Url.Action("Details", "Movie", new { area = "", id = movie.MovieID })" class="btn-book">TÌM HIỂU THÊM</a>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="carousel-slide">
                                <div class="row g-4 justify-content-center">
                                    <div class="col-12 text-center">
                                        <p class="text-muted">Hiện tại chưa có phim sắp chiếu.</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <button class="carousel-control-next" type="button" id="nextBtn3">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                </button>
            </div>

            <div class="carousel-dots" id="carouselDots3"></div>

            @if (comingSoonMovies != null && comingSoonMovies.Count > 0)
            {
                <a href="@Url.Action("upcoming", "Movie", new { area = " " })" class="btn-view-more">XEM THÊM</a>
            }
            else
            {
                <button class="btn-view-more" disabled style="opacity: 0.5; cursor: not-allowed;">XEM THÊM</button>
            }
        </div>
    </section>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // ========== CAROUSEL INITIALIZATION ==========
        initCarousel('movieCarousel', 'prevBtn', 'nextBtn', 'carouselDots');
        initCarousel('movieCarousel3', 'prevBtn3', 'nextBtn3', 'carouselDots3');

        function initCarousel(carouselId, prevBtnId, nextBtnId, dotsId) {
            const track = document.getElementById(carouselId);
            const prevBtn = document.getElementById(prevBtnId);
            const nextBtn = document.getElementById(nextBtnId);
            const dotsContainer = document.getElementById(dotsId);

            if (!track) return;

            const slides = track.querySelectorAll('.carousel-slide');
            const slideCount = slides.length;

            if (slideCount === 0) return;

            let currentSlide = 0;

            // Create dots
            if (dotsContainer) {
                dotsContainer.innerHTML = '';
                for (let i = 0; i < slideCount; i++) {
                    const dot = document.createElement('span');
                    dot.classList.add('dot');
                    if (i === 0) dot.classList.add('active');
                    dot.addEventListener('click', () => goToSlide(i));
                    dotsContainer.appendChild(dot);
                }
            }

            function updateCarousel() {
                const offset = -currentSlide * 100;
                track.style.transform = `translateX(${offset}%)`;

                if (dotsContainer) {
                    const dots = dotsContainer.querySelectorAll('.dot');
                    dots.forEach((dot, index) => {
                        dot.classList.toggle('active', index === currentSlide);
                    });
                }

                if (prevBtn) prevBtn.disabled = currentSlide === 0;
                if (nextBtn) nextBtn.disabled = currentSlide === slideCount - 1;
            }

            function goToSlide(index) {
                if (index >= 0 && index < slideCount) {
                    currentSlide = index;
                    updateCarousel();
                }
            }

            function nextSlide() {
                if (currentSlide < slideCount - 1) {
                    currentSlide++;
                    updateCarousel();
                }
            }

            function prevSlide() {
                if (currentSlide > 0) {
                    currentSlide--;
                    updateCarousel();
                }
            }

            if (prevBtn) prevBtn.addEventListener('click', prevSlide);
            if (nextBtn) nextBtn.addEventListener('click', nextSlide);

            updateCarousel();

            let resizeTimer;
            window.addEventListener('resize', function() {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(updateCarousel, 250);
            });
        }

        // ========== READ MORE FUNCTIONALITY ==========
        const readMoreBtn = document.querySelector('.read-more');
        const synopsisMore = document.querySelector('.synopsis-more');
        const ellipsis = document.querySelector('.ellipsis');

        if (readMoreBtn && synopsisMore && ellipsis) {
            readMoreBtn.addEventListener('click', function() {
                if (synopsisMore.classList.contains('hidden')) {
                    synopsisMore.classList.remove('hidden');
                    ellipsis.classList.add('hidden');
                    readMoreBtn.textContent = 'Thu gọn';
                } else {
                    synopsisMore.classList.add('hidden');
                    ellipsis.classList.remove('hidden');
                    readMoreBtn.textContent = 'Xem thêm';
                }
            });
        }

        // ========== STICKY BAR FUNCTIONALITY ==========
        const selectedSeatsDisplay = document.getElementById('selectedSeatsDisplay');
        const seatCount = document.getElementById('seatCount');
        const totalPrice = document.getElementById('totalPrice');
        const bookButton = document.getElementById('bookBtn');
        const countdownTimer = document.getElementById('countdownTimer');
        const stickyBar = document.getElementById('stickyBar');

        // Only run sticky bar code if elements exist
        if (stickyBar) {
            setTimeout(function() {
                stickyBar.classList.add('show');
            }, 500);
        }

        // Countdown timer
        if (countdownTimer) {
            let timeLeft = 300;

            function updateTimer() {
                const minutes = Math.floor(timeLeft / 60);
                const seconds = timeLeft % 60;
                countdownTimer.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

                if (timeLeft <= 60) {
                    countdownTimer.classList.add('warning');
                } else {
                    countdownTimer.classList.remove('warning');
                }

                if (timeLeft <= 0) {
                    alert('Thời gian giữ vé đã hết!');
                    document.querySelectorAll('.seat.selected').forEach(seat => {
                        seat.classList.remove('selected');
                        const originalClass = seat.textContent.includes('P') || seat.textContent.includes('Q') || seat.textContent.includes('R') ? 'couple' : 'regular';
                        seat.classList.add(originalClass);
                    });
                    updateStickyBar();
                    timeLeft = 300;
                    countdownTimer.classList.remove('warning');
                }
                timeLeft--;
            }

            setInterval(updateTimer, 1000);
        }

        // Update sticky bar function
        function updateStickyBar() {
            // Check if elements exist before accessing them
            if (!selectedSeatsDisplay || !seatCount || !totalPrice || !bookButton) return;

            const selectedSeats = document.querySelectorAll('.seat.selected');
            const seatNames = Array.from(selectedSeats).map(seat => seat.textContent).sort();

            // Safe check for cinema branch
            const cinemaBranchEl = document.getElementById('selected-branch');
            const cinemaBranch = cinemaBranchEl ? cinemaBranchEl.textContent : '';

            seatCount.textContent = selectedSeats.length;

            if (selectedSeats.length > 0) {
                selectedSeatsDisplay.textContent = seatNames.join(', ');
                const total = selectedSeats.length * 99000;
                totalPrice.textContent = total.toLocaleString('vi-VN') + ' VNĐ';
                bookButton.disabled = false;
            } else {
                selectedSeatsDisplay.textContent = 'Chưa chọn ghế';
                totalPrice.textContent = '0 VNĐ';
                bookButton.disabled = true;
            }
        }

        // ========== SEAT SELECTION ==========
        const seats = document.querySelectorAll('td.seat:not(.booked)');

        if (seats.length > 0) {
            seats.forEach(seat => {
                seat.addEventListener('click', function () {
                    this.style.transform = 'scale(0.9)';
                    setTimeout(() => {
                        this.style.transform = '';
                    }, 150);

                    if (this.classList.contains('selected')) {
                        this.classList.remove('selected');
                        const originalClass = this.textContent.includes('P') || this.textContent.includes('Q') || this.textContent.includes('R') ? 'couple' : 'regular';
                        this.classList.add(originalClass);
                    } else {
                        this.classList.add('selected');
                        this.classList.remove('regular', 'couple');
                    }
                    updateStickyBar();
                });

                seat.addEventListener('mouseenter', function() {
                    if (!this.classList.contains('booked')) {
                        this.style.transform = 'scale(1.05)';
                    }
                });

                seat.addEventListener('mouseleave', function() {
                    if (!this.classList.contains('selected')) {
                        this.style.transform = 'scale(1)';
                    }
                });
            });

            // Initial update
            updateStickyBar();
        }

        // Book button
        if (bookButton) {
            bookButton.addEventListener('click', function (e) {
                e.preventDefault();
                const selectedSeats = document.querySelectorAll('.seat.selected');

                if (selectedSeats.length === 0) {
                    alert('Vui lòng chọn ghế trước khi đặt vé!');
                    return;
                }

                window.location.href = '/Payment/Index';
            });
        }

        // ========== CATEGORY LINKS ==========
        const categoryLinks = document.querySelectorAll('.category-link');

        if (categoryLinks.length > 0) {
            categoryLinks.forEach(link => {
                link.addEventListener('click', (event) => {
                    event.preventDefault();
                    categoryLinks.forEach(l => l.classList.remove('active'));
                    link.classList.add('active');

                    const targetSectionId = link.getAttribute('href');
                    const targetSection = document.querySelector(targetSectionId);

                    if (targetSection) {
                        targetSection.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                });
            });
        }

        // ========== PRODUCT QUANTITY CONTROL ==========
        const productCards = document.querySelectorAll('.product-card');

        if (productCards.length > 0) {
            productCards.forEach(card => {
                const minusBtn = card.querySelector('.minus');
                const plusBtn = card.querySelector('.plus');
                const qtyValue = card.querySelector('.qty-value');

                if (minusBtn && plusBtn && qtyValue) {
                    minusBtn.addEventListener('click', () => {
                        let currentValue = parseInt(qtyValue.textContent);
                        if (currentValue > 0) {
                            qtyValue.textContent = currentValue - 1;
                        }
                    });

                    plusBtn.addEventListener('click', () => {
                        let currentValue = parseInt(qtyValue.textContent);
                        qtyValue.textContent = currentValue + 1;
                    });
                }
            });
        }
    });
</script>