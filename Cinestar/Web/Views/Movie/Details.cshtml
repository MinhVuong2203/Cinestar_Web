@model Movie
@section styles {
    <link href="~/css/movie.css" rel="stylesheet" />
    <link href="~/css/bookTicket.css?v=@DateTime.Now.Ticks" rel="stylesheet" />
    <link href="~/lib/fontawesome-free-7.1.0-web/css/all.min.css" rel="stylesheet" />
}
@{
    bool isComingSoon = ViewData["IsComingSoon"] as bool? ?? false;
    
    string GetAgeLimitDisplay(string code)
    {
        return code switch
        {
            "P" => "Phù hợp với mọi độ tuổi",
            "K" => "Dưới 13 tuổi cần người bảo hộ",
            "T13" => "Từ 13 tuổi trở lên (13+)",
            "T16" => "Từ 16 tuổi trở lên (16+)",
            "T18" => "Từ 18 tuổi trở lên (18+)",
            "C" => "Không được phép phổ biến",
            _ => code
        };
    }
}
<div class="container">
    @* thông tin phim*@
    <div class="movie-detail-container">
        <div class="movie-content">
            <!-- Poster Section -->
            <div class="movie-poster">
                @if (!string.IsNullOrEmpty(Model.Sub))
                {
                    <div class="type-badge">2D</div>
                }
                @if (!string.IsNullOrEmpty(Model.AgeLimit))
                {
                    <div class="age-rating">@Model.AgeLimit</div>
                }
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "~/image/no-image.jpg" : Model.ImageUrl)" alt="@Model.Title">
            </div>

            <!-- Info Section -->
            <div class="movie-info">
                <h1 class="movie-title">@Model.Title @(!string.IsNullOrEmpty(Model.AgeLimit) ? $"({Model.AgeLimit})" : "")</h1>

                <div class="movie-meta">
                    @if (!string.IsNullOrEmpty(Model.Genre))
                    {
                        <div class="meta-item">
                            <i class="fas fa-home"></i>
                            <span>@Model.Genre</span>
                        </div>
                    }

                    @if (Model.DurationMinutes != null && Model.DurationMinutes > 0)
                    {
                        <div class="meta-item">
                            <i class="far fa-clock"></i>
                            <span>@Model.DurationMinutes'</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Language))
                    {
                        <div class="meta-item">
                            <i class="fas fa-flag"></i>
                            <span>@Model.Language</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.Sub))
                    {
                        <div class="meta-item">
                            <i class="fas fa-closed-captioning"></i>
                            <span>@Model.Sub</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Model.AgeLimit))
                    {
                        <div class="meta-item age-restriction">
                            <i class="fas fa-user-friends"></i>
                            <span>@GetAgeLimitDisplay(Model.AgeLimit)</span>
                        </div>
                    }
                </div>

                <div class="movie-section">
                    <h2 class="section-title">MÔ TẢ</h2>
                    <div class="description-grid">
                        @if (Model.StartTime != null)
                        {
                            <div class="desc-item">
                                <strong>Khởi chiếu:</strong> @Model.StartTime.Value.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
                            </div>
                        }
                    </div>
                </div>

                <div class="movie-section">
                    <h2 class="section-title">NỘI DUNG PHIM</h2>
                    <div class="movie-synopsis">
                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            var description = Model.Description.Trim();
                            var shortLength = 300;

                            if (description.Length > shortLength)
                            {
                                var shortText = description.Substring(0, shortLength);
                                var remainingText = description.Substring(shortLength);

                                <p class="synopsis-text">
                                    @shortText<span class="ellipsis">...</span>
                                    <span class="synopsis-more hidden">@remainingText</span> <span class="read-more">Xem thêm</span>
                                </p>
                            }
                            else
                            {
                                <p class="synopsis-text">@description</p>
                            }
                        }
                        else
                        {
                            <p class="synopsis-text">Nội dung đang được cập nhật...</p>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.LinkTrailer))
                {
                    <a href="@Model.LinkTrailer" target="_blank" class="btn-cta btn-yellow btn-hover-purple btn-text-dark btn-text-hover-light btn-lg">
                        <i class="fas fa-play-circle"></i>
                        <span>Xem Trailer</span>
                    </a>
                }
            </div>
        </div>
    </div>

    @* Phần đặt vé - CHỈ HIỂN THỊ KHI PHIM ĐANG CHIẾU *@
    @if (isComingSoon)
    {
        <!-- THÔNG BÁO PHIM SẮP CHIẾU -->
        <div class="coming-soon-notice">
            <div>
                <i class="fas fa-calendar-alt"></i>
                <h2>HIỆN CHƯA CÓ LỊCH CHIẾU</h2>
                <p>Phim dự kiến khởi chiếu: <strong>@Model.StartTime?.ToString("dd/MM/yyyy")</strong></p>
                <p>Vui lòng quay lại sau để đặt vé</p>
                <div style="margin-top: 30px;">
                    <a href="/movie" class="btn-cta btn-yellow btn-hover-purple btn-lg">
                        <i class="fas fa-arrow-left"></i> Quay lại trang chủ
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        @* ===== PHẦN NÀY CHỈ HIỂN THỊ KHI PHIM ĐANG CHIẾU ===== *@
  
            var branches = ViewData["Branches"] as List<CinemaBranch> ?? new List<CinemaBranch>();
            var selectedBranch = ViewData["SelectedBranch"] as CinemaBranch;
            var selectedCity = ViewData["SelectedCity"] as string ?? "HỒ CHÍ MINH";
        

        <div class="shtime-wr">
            <!-- ========== LỊCH CHIẾU (7 NGÀY) ========== -->
            <div class="shtime-heading">
                <h2 class="heading">LỊCH CHIẾU</h2>
                <div class="selected-time" id="selectedTimeContainer">
                    @for (int i = 0; i < 7; i++)
                    {
                        var date = DateTime.Today.AddDays(i);
                        var dateStr = date.ToString("yyyy-MM-dd");
                        var dayName = date.ToString("ddd", new System.Globalization.CultureInfo("vi-VN"));

                        <div class="box-time @(i == 0 ? "active" : "")"
                             data-date="@dateStr"
                             data-movie-id="@Model.MovieID">
                            <p class="date">@date.ToString("dd/MM")</p>
                            <p class="day">@dayName</p>
                        </div>
                    }
                </div>
            </div>

            <!-- ========== CHỌN THÀNH PHỐ ========== -->
            <div class="shtime-body">
                <h2 class="heading">DANH SÁCH RẠP</h2>
                <div class="select-location">
                    <div class="location-selected">
                        <i class="fas fa-location-dot" style="color: #ffffff;"></i>
                        <span class="location-name">@selectedCity</span>
                        <span class="dropdown-arrow">&#9662;</span>
                    </div>

                    <div class="location-dropdown">
                        @if (ViewData["lstCity"] != null)
                        {
                            var cities = ViewData["lstCity"] as List<string>;
                            foreach (var city in cities)
                            {
                                <div class="location-option"
                                     data-city="@city"
                                     data-movie-id="@Model.MovieID">
                                    @city
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- ========== DANH SÁCH RẠP ========== -->
            <div class="shtime-fr" id="branchesContainer">
                @if (branches.Any())
                {
                    <ul class="cinestar-list">
                        @foreach (var branch in branches)
                        {
                            var isFirst = branch == branches.First();

                            <li class="cinestar-item @(isFirst ? "open" : "")"
                                data-branch-id="@branch.BranchID">

                                <!-- Tiêu đề rạp -->
                                <div class="cinestar-heading">
                                    <h4 class="title">@branch.BranchName</h4>
                                    <span class="chevron">
                                        <i class="fa-solid fa-chevron-down" style="color: #ffffff;"></i>
                                    </span>
                                </div>

                                <!-- Thông tin rạp & lịch chiếu -->
                                <div class="cinestar-body">
                                    <p class="address">@branch.Address, @branch.District</p>

                                    <div class="showtime-container" data-branch-id="@branch.BranchID">
                                        <p class="loading">Đang tải lịch chiếu...</p>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="no-data">Không có rạp chiếu phim này tại khu vực đã chọn</p>
                }
            </div>

            <!-- ========== STICKY BAR (THANH TOÁN) ========== -->
            <div class="sticky-bar" id="stickyBar">
                <div class="movie-info">
                    <h3 class="movie-title1">
                        @Model.Title @(!string.IsNullOrEmpty(Model.AgeLimit) ? $"({Model.AgeLimit})" : "")
                    </h3>
                    <p class="cinema-info">
                        <i class="fas fa-map-marker-alt"></i>
                        <span id="cinemaName">@(selectedBranch?.BranchName ?? "Chưa chọn rạp")</span> |
                        <span id="selectedSeatsDisplay">Chưa chọn suất</span>
                    </p>
                </div>

                <div class="time-price">
                    <!-- Đồng hồ đếm ngược -->
                    <div class="time-section">
                        <span class="time-label">
                            <i class="fas fa-clock"></i>
                            Thời gian giữ vé:
                        </span>
                        <div class="time-box" id="countdownTimer">05:00</div>
                    </div>

                    <!-- Tổng tiền -->
                    <div class="price-section">
                        <span class="price-label">Tạm tính</span>
                        <span class="price-amount" id="totalPrice">0 VNĐ</span>
                    </div>

                    <!-- Nút đặt vé -->
                    <button class="book-btn1" id="bookBtn" disabled>
                        <i class="fas fa-ticket-alt"></i>
                        <span>ĐẶT VÉ</span>
                    </button>
                </div>
            </div>

            <script src="~/js/bookTicket.js?v=@DateTime.Now.Ticks"></script>
        </div>

        <!-- CHỌN GHẾ --> 
        <h1 class="TitleBrand">Chọn ghế - Rạp 03</h1>
        <div style="position: relative;">
            <img src="~/image/img-screen.png" class="screen"></img>
            <div class="screen-label">Màn hình</div>
        </div>

        <div class="seating-area">
            <table id="seatingTable">
