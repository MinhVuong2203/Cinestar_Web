<script>
        document.addEventListener('DOMContentLoaded', function() {
        const readMoreBtn = document.querySelector('.read-more');
        const synopsisMore = document.querySelector('.synopsis-more');
        const ellipsis = document.querySelector('.ellipsis');

        if (readMoreBtn && synopsisMore && ellipsis) {
            readMoreBtn.addEventListener('click', function() {
                if (synopsisMore.classList.contains('hidden')) {
                    // Hiện nội dung đầy đủ, ẩn dấu ba chấm
                    synopsisMore.classList.remove('hidden');
                    ellipsis.classList.add('hidden');
                    readMoreBtn.textContent = 'Thu gọn';
                } else {
                    // Ẩn nội dung, hiện lại dấu ba chấm
                    synopsisMore.classList.add('hidden');
                    ellipsis.classList.remove('hidden');
                    readMoreBtn.textContent = 'Xem thêm';
                }
            });
        }

    // === STICKY BAR FUNCTIONALITY ===
    const selectedSeatsDisplay = document.getElementById('selectedSeatsDisplay');
    const seatCount = document.getElementById('seatCount');
    const totalPrice = document.getElementById('totalPrice');
    const bookButton = document.getElementById('bookBtn');
    const countdownTimer = document.getElementById('countdownTimer');
    const stickyBar = document.getElementById('stickyBar');

    // Show sticky bar after page loads with class
    setTimeout(function() {
        if (stickyBar) {
            stickyBar.classList.add('show');
        }
    }, 500);

    // Countdown timer (5 minutes)
    let timeLeft = 300;
    function updateTimer() {
        const minutes = Math.floor(timeLeft / 60);
        const seconds = timeLeft % 60;
        if (countdownTimer) {
            countdownTimer.textContent = `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

            // Change color when time is low (1 minute)
            if (timeLeft <= 60) {
                countdownTimer.classList.add('warning');
            } else {
                countdownTimer.classList.remove('warning');
            }
        }

        if (timeLeft <= 0) {
            alert('Thời gian giữ vé đã hết!');
            // Reset selections
            document.querySelectorAll('.seat.selected').forEach(seat => {
                seat.classList.remove('selected');
                const originalClass = seat.textContent.includes('P') || seat.textContent.includes('Q') || seat.textContent.includes('R') ? 'couple' : 'regular';
                seat.classList.add(originalClass);
            });
            updateStickyBar();
            timeLeft = 300; // Reset timer
            if (countdownTimer) {
                countdownTimer.classList.remove('warning');
            }
        }
        timeLeft--;
    }

    // Start timer
    setInterval(updateTimer, 1000);

    // Update sticky
    function updateStickyBar() {
        const selectedSeats = document.querySelectorAll('.seat.selected');
        const seatNames = Array.from(selectedSeats).map(seat => seat.textContent).sort();
        const cinemaBranch = document.getElementById('selected-branch').textContent;

   //      if (cinemaBranch) {
   //          Update cinema branch display
			// const cinemaInfo = document.querySelector('.cinema-info');
			// if (cinemaInfo) cinemaInfo.textContent = "Cinema " + cinemaBranch;

   //      }

        // Update seat count
        if (seatCount) seatCount.textContent = selectedSeats.length;

        if (selectedSeats.length > 0) {
            // Update selected seats display
            if (selectedSeatsDisplay) selectedSeatsDisplay.textContent = seatNames.join(', ');

            // Calculate total price
            const total = selectedSeats.length * 99000; // 99,000 VND per seat
            if (totalPrice) totalPrice.textContent = total.toLocaleString('vi-VN') + ' VNĐ';

            // Enable book button
            if (bookButton) {
                bookButton.disabled = false;
            }
        } else {
            // No seats selected
            if (selectedSeatsDisplay) selectedSeatsDisplay.textContent = 'Chưa chọn ghế';
            if (totalPrice) totalPrice.textContent = '0 VNĐ';

            // Disable book button
            if (bookButton) {
                bookButton.disabled = true;
            }
        }
    }

    // Seat selection logic with animation
    const seats = document.querySelectorAll('td.seat:not(.booked)');
    seats.forEach(seat => {
        seat.addEventListener('click', function () {
            // Add click effect
            this.style.transform = 'scale(0.9)';
            setTimeout(() => {
                this.style.transform = '';
            }, 150);

            if (this.classList.contains('selected')) {
                this.classList.remove('selected');
                // Restore original class
                const originalClass = this.textContent.includes('P') || this.textContent.includes('Q') || this.textContent.includes('R') ? 'couple' : 'regular';
                this.classList.add(originalClass);
            } else {
                this.classList.add('selected');
                this.classList.remove('regular', 'couple');
            }
            updateStickyBar();
        });

        // Add hover effects
        seat.addEventListener('mouseenter', function() {
            if (!this.classList.contains('booked')) {
                this.style.transform = 'scale(1.05)';
            }
        });

        seat.addEventListener('mouseleave', function() {
            if (!this.classList.contains('selected')) {
                this.style.transform = 'scale(1)';
            }
        });
    });

    // Book button functionality
    if (bookButton) {
         bookButton.addEventListener('click', function (e) {
             e.preventDefault();

             const selectedSeats = document.querySelectorAll('.seat.selected');

             if (selectedSeats.length === 0) {
                 alert('Vui lòng chọn ghế trước khi đặt vé!');
                 return;
             }

             window.location.href = '/Payment/Index';
         });
    }

    // Initial update
    updateStickyBar();
    });

        // const seats = document.querySelectorAll('td.seat:not(.booked)');

        // seats.forEach(seat => {
        //     seat.addEventListener('click', function() {
        //         if (this.classList.contains('selected')) {
        //             if (this.classList.contains('couple')) {
        //                 this.classList.remove('selected');
        //                 this.classList.add('couple');
        //             } else {
        //                 this.classList.remove('selected');
        //                 this.classList.add('regular');
        //             }
        //         } else {
        //             this.classList.add('selected');
        //             this.classList.remove('regular', 'couple');
        //         }
        //     });
        // });


    document.addEventListener('DOMContentLoaded', function() {
        const categoryLinks = document.querySelectorAll('.category-link');

        categoryLinks.forEach(link => {
            link.addEventListener('click', (event) => {
                event.preventDefault(); // Ngăn hành vi mặc định của thẻ a

                // Xóa class 'active' khỏi tất cả các link
                categoryLinks.forEach(l => l.classList.remove('active'));

                // Thêm class 'active' vào link vừa được nhấn
                link.classList.add('active');

                // Lấy id của section từ href của link
                const targetSectionId = link.getAttribute('href');

                // Cuộn mượt mà đến section tương ứng
                const targetSection = document.querySelector(targetSectionId);
                if (targetSection) {
                    targetSection.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start' // Cuộn đến đầu của section
                    });
                }
            });
        });
    });
    document.addEventListener('DOMContentLoaded', function() {
        // Xử lý nút tăng/giảm số lượng
        const productCards = document.querySelectorAll('.product-card');

        productCards.forEach(card => {
            const minusBtn = card.querySelector('.minus');
            const plusBtn = card.querySelector('.plus');
            const qtyValue = card.querySelector('.qty-value');

            minusBtn.addEventListener('click', () => {
                let currentValue = parseInt(qtyValue.textContent);
                // Thay đổi ở đây: cho phép giảm xuống 0
                if (currentValue > 0) {
                    qtyValue.textContent = currentValue - 1;
                }
            });

            plusBtn.addEventListener('click', () => {
                let currentValue = parseInt(qtyValue.textContent);
                qtyValue.textContent = currentValue + 1;
            });
        });
    });
</script>
