@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Thông tin cá nhân";
	var loggedCustomer = ViewData["LoggedCustomer"] as Web.Models.Customer;
    var purchasedTickets = ViewData["PurchasedTickets"] as List<Web.Models.DTOs.PurchasedTicketDto>;
}
@section Styles {
    <link rel="stylesheet" href="~/css/CinestartMember.css?v=@DateTime.Now.Ticks">
    <link rel="stylesheet" href="~/css/PurchaseHistory.css?v=@DateTime.Now.Ticks" />
}

<div class="container-Member">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="profile">
            <div class="avatar">
                <span>👤</span>
            </div>
            <div class="profile-info">
                <h3>@(User.Identity?.Name ?? "Nguyễn Bình Minh")</h3>
                <a href="#">
                    <p>Thay đổi ảnh đại diện</p>
                </a>
            </div>
        </div>

        <div class="menu">
            <div class="menu-item active">CFriends</div>
            <div class="point">
                <div class="menu-item">Tích điểm CFriends</div>
                <progress max="100"></progress>
                <div class="menu-item">0/10k</div>
            </div>
            <div class="menu-item" data-page="profile">
                <span class="icon">👤</span>
                Thông tin khách hàng
            </div>
            <div class="menu-item" data-page="member">
                <span class="icon">⭐</span>
                Thành viên Cinestar
            </div>
            <div class="menu-item selected" data-page="purchase-history">
                <span class="icon">🛒</span>
                Lịch sử mua hàng
            </div>
            @* <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm" style="margin: 0;"> *@
            @* <a href="/Account/Logout" id="logoutForm">
                @Html.AntiForgeryToken()
                <button type="submit" class="menu-item logout">
                    <span class="icon">🚪</span>
                    <span>Đăng xuất</span>
                </button>
            </a> *@
            @* </form> *@
            <div class="menu-item">
                <a href="/Account/Logout" id="logoutLink" class="logout">
                    <span class="icon">🚪</span>
                    <span>Đăng xuất</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Main content -->
    <div class="main-content">
        <h1>LỊCH SỬ MUA HÀNG</h1>

        @if (purchasedTickets != null && purchasedTickets.Any())
        {
            <table class="history-table">
                <thead>
                    <tr>
                        <th>Phim</th>
                        <th>Suất chiếu</th>
                        <th>Ghế</th>
                        <th>Giá vé</th>
                        <th>Rạp</th>
                        <th>Phòng</th>
                        <th>Loại vé</th>
                        <th>Trạng thái</th>
                        <th>Ngày mua</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ticket in purchasedTickets)
                    {
                        <tr>
                            <td>@ticket.MovieTitle</td>
                            <td>@ticket.ShowTime.ToString("HH:mm dd/MM/yyyy")</td>
                            <td>@ticket.SeatName</td>
                            <td>@ticket.Price.ToString("N0") VNĐ</td>
                            <td>@ticket.BranchName</td>
                            <td>@ticket.RoomName</td>
                            <td>@ticket.TicketType</td>
                            <td>
                                @{
                                    var statusClass = ticket.Status == "Đã thanh toán" ? "status-paid"
                                    : ticket.Status == "Đã hủy" ? "status-cancel"
                                    : "status-pending";
                                }
                                <span class="@statusClass">@ticket.Status</span>
                            </td>
                            <td>@(ticket.PurchaseDate?.ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="no-history">
                Bạn chưa có lịch sử mua vé nào.
            </div>
        }
    </div>
</div>

<script src="~/js/PurchaseHistory.js?v=@DateTime.Now.Ticks"></script>