    @* HMINH html *@
    <section class="promotion-section">
        <div class="container">
            <h2 class="section-title text-center">KHUYẾN MÃI</h2>

            <div id="promotionCarousel" class="carousel slide" data-bs-ride="false">
                <!-- data-bs-ride="false" để tắt auto-slide -->
                <!-- Carousel Items -->
                <div class="carousel-inner">
                    <!-- Chỉ còn 1 carousel-item duy nhất -->
                    <div class="carousel-item active">
                        <div class="cards-wrapper">
                            <!-- Tất cả các thẻ đều nằm ở đây -->
                            <div class="col-md-4">
                                <div class="promotion-card">
                                    <img src="~/image/sale/cschool_45k.webp" class="card-img" alt="C'School">

                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="promotion-card">
                                    <img src="~/image/sale/happy_hour.webp" class="card-img" alt="Happy Hour">
                                   
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="promotion-card">
                                    <img src="~/image/sale/thu4_happy_day.webp" class="card-img" alt="Happy Day">
                                   
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="promotion-card">
                                    <img src="~/image/sale/thu2_vv.webp" class="card-img" alt="Ưu đãi 1">
                                    
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Nút điều hướng -->
                <button class="carousel-control-prev custom-nav-btn" type="button" id="prevSlide">
                    <i class="fas fa-chevron-left"></i>
                </button>
                <button class="carousel-control-next custom-nav-btn" type="button" id="nextSlide">
                    <i class="fas fa-chevron-right"></i>
                </button>
            </div>

            <!-- Nút Tất Cả Ưu Đãi -->
            <div class="text-center mt-5">
                <a href="#" class="btn all-offers-btn">TẤT CẢ ƯU ĐÃI</a>
            </div>
        </div>
    </section>

    <section class="membership-section">
        <h2 class="section-title">Chương Trình Thành Viên</h2>

        <div class="membership-container">
            <!-- C'Friend Membership Card -->
            <div class="membership-card cfriend">
                <div class="card-image">
                    <img src="~/image/membership/cfriend.webp" alt="Thành viên C'Friend">
                </div>
                <div class="card-content">
                    <h3 class="card-title">THÀNH VIÊN C'FRIEND</h3>
                    <p>Thẻ C'Friend mang đến nhiều ưu đãi hấp dẫn cho người mới.</p>
                    <a href="#" class="register-btn">Đăng ký ngay</a>
                </div>
            </div>

            <!-- C'VIP Membership Card -->
            <div class="membership-card cvip">
                <div class="card-image">
                    <img src="~/image/membership/cvip.webp" alt="Thành viên C'VIP">
                </div>
                <div class="card-content">
                    <h3 class="card-title">THÀNH VIÊN C'VIP</h3>
                    <p>Thẻ VIP CineStar dành riêng cho bạn nhưng đặc quyền chất riêng.</p>
                    <a href="#" class="register-btn">Đăng ký ngay</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Section Dịch Vụ Giải Trí Khác -->
    <section class="entertainment-section">
        <div class="container">
            <h2 class="section-title">Dịch Vụ Giải Trí Khác</h2>
            <p class="section-description">
                Cinestar không chỉ bán vé xem phim mà còn cung cấp nhiều dịch vụ giải trí khác nhau để bạn và gia đình có những giây phút thư giãn vui vẻ.
            </p>

            <div class="services-grid">
                <!-- Kidzone -->
                <div class="service-item">
                    <img src="~/image/other_services/kidzone.webp" alt="Kidzone">

                </div>

                <!-- Bowling -->
                <div class="service-item">
                    <img src="~/image/other_services/bowling.webp" alt="Bowling">

                </div>

                <!-- Billiards -->
                <div class="service-item">
                    <img src="~/image/other_services/billard.webp" alt="Billiards">

                </div>

                <!-- Món ngon -->
                <div class="service-item">
                    <img src="~/image/other_services/monngon.webp" alt="Món ngon">

                </div>

                <!-- Gym -->
                <div class="service-item">
                    <img src="~/image/other_services/gym.webp" alt="Gym">

                </div>

                <!-- Dalat Opera House -->
                <div class="service-item">
                    <img src="~/image/other_services/opera.webp" alt="Dalat Opera House">

                </div>
            </div>
        </div>
    </section>

    <!-- Section Liên Hệ Với Chúng Tôi -->
    <section class="contact-section">
        <div class="container">
            <div class="row align-items-center">
                <!-- Cột trái: Nút mạng xã hội -->
                <div class="col-lg-6 col-md-12">
                    <div class="contact-left text-center text-lg-start">
                        <h2 class="contact-title">LIÊN HỆ VỚI CHÚNG TÔI</h2>

                        <a href="#" class="btn social-btn btn-facebook">
                            <i class="fab fa-facebook-f me-2"></i> FACEBOOK
                        </a>

                        <a href="#" class="btn social-btn btn-zalo">
                            <i class="fas fa-comment me-2"></i> ZALO CHAT
                        </a>
                    </div>
                </div>

                <!-- Cột phải: Thông tin liên hệ và form -->
                <div class="col-lg-6 col-md-12">
                    <div class="contact-info-box">
                        <h3 class="info-title">THÔNG TIN LIÊN HỆ</h3>

                        <ul class="contact-info-list list-unstyled">
                            <li><i class="fas fa-envelope me-2"></i> cskh@cinestar.com.vn</li>
                            <li><i class="fas fa-phone me-2"></i> 1900 0085</li>
                            <li><i class="fas fa-map-marker-alt me-2"></i> 135 Hải Bà Trưng, phường Sài Gòn, TP.HCM</li>
                        </ul>

                        <form id="contactForm" class="mt-4">
                            <div class="mb-3">
                                <input type="text" class="form-control" placeholder="Họ và tên" required>
                            </div>
                            <div class="mb-3">
                                <input type="email" class="form-control" placeholder="Email" required>
                            </div>
                            <div class="mb-3">
                                <textarea class="form-control" rows="4" placeholder="Lời nhắn" required></textarea>
                            </div>
                            <button type="submit" class="btn submit-btn">GỬI NGAY</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<script src="~/js/Customer/homeCustomer.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

@* gjgj *@

@* Sửa lỗi nè *@