@{
    ViewData["Title"] = "Home Page";
}
@section styles{
    <link href="~/css/Customer/homeCustomer.css" rel="stylesheet" />
}
<div class="container">
    <section class="section-1">
        <!-- Carousel -->
        <div id="promoCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="~/image/movie/banner-web-hoisinh.jpg" class="d-block w-100" alt="Slide 1">
                </div>

                <div class="carousel-item">
                    <img src="~/image/movie/chaching.jpg" class="d-block w-100" alt="Slide 2">
                </div>

                <div class="carousel-item">
                    <img src="~/image/movie/phimhot10.jpg" class="d-block w-100" alt="Slide 3">
                </div>
                <div class="carousel-item">
                    <img src="~/image/movie/cuc-vang-cua-ngoai-banner.jpg" class="d-block w-100" alt="Slide 4">
                </div>
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#promoCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#promoCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>

        @* <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script> *@

        <!-- Booking Section -->
        <div class="booking-section">
            <div class="container-fluid">
                <div class="row align-items-center g-3">
                    <div class="col-auto">
                        <h3 class="booking-title">ĐẶT VÉ NHANH</h3>
                    </div>

                    <div class="col-auto">
                        <select class="form-select combo-box combo-disabled" id="cinema" disabled>
                            <option value="" selected disabled hidden>1. Chọn Rạp</option>
                            <option value="kg">Cinestar Kiên Giang</option>
                            <option value="qt">Cinestar Quốc Thanh</option>
                            <option value="hbt">Cinestar Hai Bà Trưng</option>
                            <option value="q6">Cinestar Saira Quận 6</option>
                            <option value="dl">Cinestar Đà Lạt</option>
                        </select>
                    </div>

                    <div class="col-auto">
                        <select class="form-select combo-box combo-disabled" id="movie" disabled>
                            <option value="" selected disabled hidden>2. Chọn Phim</option>
                            <option value="1">Cục Vàng Của Ngày Mai</option>
                            <option value="2">Venom: Kèo Cuối</option>
                            <option value="3">Thần Dược</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <select class="form-select combo-box combo-disabled" id="date" disabled>
                            <option value="" selected disabled hidden>3. Chọn Ngày</option>
                            <option value="1">Thứ Hai, 27/10</option>
                            <option value="2">Thứ Ba, 28/10</option>
                            <option value="3">Thứ Tư, 29/10</option>
                        </select>
                    </div>

                    <div class="col-auto">
                        <select class="form-select combo-box combo-disabled" id="time" disabled>
                            <option value="" selected disabled hidden>4. Chọn Suất</option>
                            <option value="1">14:00 - 2D Standard</option>
                            <option value="2">16:30 - 2D Standard</option>
                            <option value="3">19:00 - 2D Standard</option>
                            <option value="4">21:30 - 2D Standard</option>
                        </select>
                    </div>

                    <div class="col-auto">
                        <button class="btn-xs btn-cta btn-purple" id="bookBtn" disabled>ĐẶT NGAY</button>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="section-2">
